# Check for dependencies
[group('helpers')]
_check-dependencies dependencies='k3d':
	#!/usr/bin/env bash
	set -euo pipefail
	RED='\033[0;31m'
	NC='\033[0m' # No Color
	dependencies="docker kubectl helm helmfile linkerd openssl gettext"
	for dep in $dependencies; do
		if ! which $dep > /dev/null 2>&1; then
			echo -e "${RED}ERROR: $dep not found. Please install $dep first.${NC}"
			exit 1
		fi
	done
	if ! which {{dependencies}} > /dev/null 2>&1; then
		echo -e "${RED}ERROR: {{dependencies}} not found. Please install {{dependencies}} first.${NC}"
		exit 1
	fi
	if ! helm diff version > /dev/null 2>&1; then
		echo -e "${RED}ERROR: Helm Diff plugin not found. Please install Helm Diff plugin first.${NC}"
		exit 1
	fi

# Install dependencies: release downloads checked against the sha256 images/gitops-helmfile/Dockerfile
# pins (linkerd's from tools.env), never an install script from a branch (F-DEP2-012).
[group('helpers')]
[linux]
install-dependencies:
	if ! which docker > /dev/null; then \
		curl -fsSL https://get.docker.com -o get-docker.sh; \
		sh get-docker.sh; \
		sudo usermod -aG docker $USER; \
		newgrp docker; \
		rm get-docker.sh; \
	else \
		echo "Docker is already installed."; \
	fi
	if ! which kubectl > /dev/null; then \
		curl -fsSLO "https://dl.k8s.io/release/v1.35.9/bin/linux/amd64/kubectl"; \
		echo "3cfeaf80be482b435b0aa214aff6e0b2c312ee23c0ff20810c75517b6004c6eb  kubectl" | sha256sum -c - || exit 1; \
		sudo install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl && rm kubectl; \
	else \
		echo "kubectl is already installed."; \
	fi
	if ! which helm > /dev/null; then \
		curl -fsSL -o helm.tgz https://get.helm.sh/helm-v4.3.0-linux-amd64.tar.gz; \
		echo "86584a54def73570558f66f5111cc53dfed56689637ae32c1201205d494f54fb  helm.tgz" | sha256sum -c - || exit 1; \
		tar -xzf helm.tgz linux-amd64/helm && sudo install -o root -g root -m 0755 linux-amd64/helm /usr/local/bin/helm; \
		rm -rf helm.tgz linux-amd64; \
		helm plugin install https://github.com/databus23/helm-diff; \
	else \
		echo "Helm is already installed."; \
	fi
	if ! which helmfile > /dev/null; then \
		curl -fsSLO https://github.com/helmfile/helmfile/releases/download/v1.8.1/helmfile_1.8.1_linux_amd64.tar.gz; \
		echo "ccabbe75dddbc25008d055fe92a44f95a184342211e7244d32b870409239c7a3  helmfile_1.8.1_linux_amd64.tar.gz" | sha256sum -c - || exit 1; \
		tar -xzf helmfile_1.8.1_linux_amd64.tar.gz helmfile && sudo install -o root -g root -m 0755 helmfile /usr/local/bin/helmfile; \
		rm helmfile_1.8.1_linux_amd64.tar.gz helmfile; \
	else \
		echo "Helmfile is already installed."; \
	fi
	if ! which linkerd > /dev/null; then \
		curl -fsSL -o linkerd https://github.com/linkerd/linkerd2/releases/download/edge-26.9.1/linkerd2-cli-edge-26.9.1-linux-amd64; \
		echo "094e1de06215fbe76fc011cf62c96214f8dae0cd5a58135fb40307be88b6b176  linkerd" | sha256sum -c - || exit 1; \
		sudo install -o root -g root -m 0755 linkerd /usr/local/bin/linkerd && rm linkerd; \
		linkerd version --client; \
	else \
		echo "Linkerd is already installed."; \
	fi
	if ! which sops > /dev/null; then \
		curl -sSL -o sops https://github.com/getsops/sops/releases/download/v3.13.3/sops-v3.13.3.linux.amd64; \
		sudo install -o root -g root -m 0755 sops /usr/local/bin/sops && rm sops; \
	else \
		echo "sops is already installed."; \
	fi
	if ! which age > /dev/null; then \
		curl -sSL https://github.com/FiloSottile/age/releases/download/v1.2.1/age-v1.2.1-linux-amd64.tar.gz | tar xz; \
		sudo install -o root -g root -m 0755 age/age age/age-keygen /usr/local/bin/ && rm -r age; \
	else \
		echo "age is already installed."; \
	fi
	if ! which openssl > /dev/null; then \
		sudo apt-get update && sudo apt-get install -y openssl; \
	else \
		echo "OpenSSL is already installed."; \
	fi
	if ! which gettext > /dev/null; then \
		sudo apt-get update && sudo apt-get install -y gettext-base; \
	else \
		echo "gettext is already installed."; \
	fi
[macos]
install-dependencies:
	echo "Please check ../docs/Deployment/01-prerequisites.md for required dependencies and adjust your system accordingly."


# ---------------------------------------------------------------------------
# dev cluster (single-node Hetzner k3s, see CLAUDE.md). The recipes below are the
# only supported way to change it: they assemble deployment/ from the committed
# defaults + ci/example-deployments/environments/dev, so the cluster equals main.
# ---------------------------------------------------------------------------

dev_domain := env('JC_DEV_DOMAIN', 'dev.joinedcontext.com')
# Private values live in the private environments/ checkout JC_ENVIRONMENTS names (an absolute path;
# T-6979 §3, T-6982, T-6984), never in this public repository.
environments_dir := env('JC_ENVIRONMENTS', '')

# The address of one cluster's node, from <environments>/nodes.yaml; there is no default address.
# The guards compare it with the kube context's server.
_node-ip cluster:
	#!/usr/bin/env bash
	set -euo pipefail
	[ -n "{{ environments_dir }}" ] || { echo "no node address for {{ cluster }}: set JC_ENVIRONMENTS to the private environments/ checkout" >&2; exit 1; }
	nodes="{{ environments_dir }}/nodes.yaml"
	[ -f "$nodes" ] || { echo "no node address for {{ cluster }}: $nodes is missing; set JC_ENVIRONMENTS to the environments/ checkout" >&2; exit 1; }
	ip=$(yq '.["{{ cluster }}"] // ""' "$nodes")
	[[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || { echo "$nodes names no IPv4 address for {{ cluster }} (got '$ip')" >&2; exit 1; }
	echo "$ip"

# Refuse to touch anything but the dev cluster
[group('dev cluster')]
_dev-guard:
	#!/usr/bin/env bash
	set -euo pipefail
	ip="${JC_DEV_NODE_IP:-$(just _node-ip dev)}"
	server=$(kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null || true)
	case "$server" in
		*"$ip"*) ;;
		*) echo "refusing: current kube context points at '${server:-<none>}', not the dev cluster ($ip). Set KUBECONFIG=.secrets/kubeconfig-dev.yaml" >&2; exit 1 ;;
	esac

# The old dev environment is off while environments/dev/RETIRED exists (owner 2026-11-10): an
# apply of it would bring back what was scaled to 0. jc-dev and jc-prod applies do not read it.
[group('dev cluster')]
_dev-retired:
	#!/usr/bin/env bash
	set -euo pipefail
	marker=ci/example-deployments/environments/dev/RETIRED
	if [ -f "$marker" ]; then
		echo "refusing: the old dev environment is retired ($marker):" >&2
		cat "$marker" >&2
		exit 1
	fi

# Assemble deployment/ from the committed defaults and the dev environment
[group('dev cluster')]
_dev-assemble:
	#!/usr/bin/env bash
	set -euo pipefail
	rm -rf deployment
	cp -r defaults/deployment deployment
	cp ci/example-deployments/helmfile.yaml deployment/helmfile.yaml
	cp -r ci/example-deployments/environments/. deployment/environments/
	# The private overlay (docs/Deployment/01-repository-layout.md §2): each private environment
	# and secrets/ from JC_ENVIRONMENTS, never over a public example of the same name.
	[ -n "{{ environments_dir }}" ] || exit 0
	[ -d "{{ environments_dir }}" ] || { echo "JC_ENVIRONMENTS={{ environments_dir }} is no directory" >&2; exit 1; }
	mapfile -t names < <(yq 'select(document_index == 0) | .environments | keys | .[]' ci/example-deployments/helmfile.yaml)
	for name in "${names[@]}" secrets; do
		[ -d "{{ environments_dir }}/$name" ] || continue
		if [ -e "deployment/environments/$name" ]; then
			echo "environment $name is a public example: JC_ENVIRONMENTS/$name may not shadow it" >&2
			exit 1
		fi
		cp -r "{{ environments_dir }}/$name" "deployment/environments/$name"
	done

# Apply the dev environment to the dev cluster and wait for every rollout. Syncs only the
# releases whose render moved since the commit dev last recorded (T-6135); the whole
# environment when that cannot be judged safely (scripts/apply-pins.py plan) or with full=true.
# While the model spend guard holds it leaves agent-runner-proxy out (T-6155, see dev-apply-pins);
# spend_guard=off syncs it too.
[group('dev cluster')]
dev-apply full='false' spend_guard='on':
	#!/usr/bin/env bash
	set -euo pipefail
	just _dev-guard
	just _dev-retired
	just _dev-assemble
	started=$(date -u +%s)
	selectors=()
	case "{{ spend_guard }}" in on | off) ;; *) echo "spend_guard is on or off, not '{{ spend_guard }}'" >&2; exit 2 ;; esac
	if [ "{{ full }}" = true ]; then
		plan=full
	else
		base=$(kubectl -n dev get configmap jc-release -o jsonpath='{.data.commit}' 2>/dev/null || true)
		# a base applied from a dirty tree is no base: its render is unknown
		describe=$(kubectl -n dev get configmap jc-release -o jsonpath='{.data.describe}' 2>/dev/null || true)
		case "$describe" in *-dirty) base="" ;; esac
		# a full sync at least every JC_FULL_SYNC_HOURS (6) converges drift the render cannot see (T-6187)
		full_at=$(kubectl -n dev get configmap jc-release -o jsonpath='{.data.fullSyncAt}' 2>/dev/null || true)
		# any failure of the planner is a full sync, never a skipped one
		plan=$(./scripts/apply-pins.py plan dev "$base" "$full_at") || plan=full
	fi
	if [ "$plan" != full ]; then
		mapfile -t releases < <(printf '%s' "$plan" | sed '/^$/d')
		if [ "{{ spend_guard }}" = on ] && grep -qxF agent-runner-proxy <<<"$plan"; then
			echo "skipping agent-runner-proxy: the spend guard keeps it at 0 replicas (spend_guard=off syncs it; once the guard lifts, just dev-apply true off brings it to HEAD)"
			mapfile -t releases < <(printf '%s' "$plan" | sed '/^$/d;/^agent-runner-proxy$/d')
		fi
		for r in "${releases[@]}"; do selectors+=(--selector "name=$r"); done
		echo "dev-apply ${base:0:12}..$(git rev-parse --short=12 HEAD): ${releases[*]:-no release moved}"
	else
		echo "dev-apply: full sync"
		if [ "{{ spend_guard }}" = on ]; then
			echo "skipping agent-runner-proxy: the spend guard keeps it at 0 replicas (spend_guard=off syncs it; once the guard lifts, just dev-apply true off brings it to HEAD)"
			selectors+=(--selector "name!=agent-runner-proxy")
		fi
	fi
	# Every platform digest of the render carries our workflows' signature, or nothing is applied (T-5564).
	./scripts/verify-pinned-images.py dev
	if [ "$plan" = full ] || [ "${#selectors[@]}" -gt 0 ]; then
		# The walker holds its walk while this stamp is newer than appliedAt (T-6425); no first
		# record to stamp stops no apply.
		./scripts/release.py start dev || true
		helmfile -f deployment/helmfile.yaml -e dev sync --concurrency {{helmfile_concurrency}} "${selectors[@]}"
	fi
	./scripts/wait-rollouts.sh dev
	echo "dev-apply synced and rolled out in $(( $(date -u +%s) - started )) s"
	# What dev runs now, who applied it and when (T-4955); dev-smoke prints it. A full sync also
	# stamps fullSyncAt, which the next plans read.
	./scripts/release.py record dev dev $([ "$plan" = full ] && echo --full)

# The checks dev-smoke and prod-smoke share, against one instance (its domain and namespace)
[group('dev cluster')]
_smoke domain namespace:
	#!/usr/bin/env bash
	set -euo pipefail
	rc=0
	./scripts/release.py show "{{ namespace }}"
	# One lookup, then every curl goes to that address (T-3420): the sandbox resolver stalls up
	# to 15 s per lookup, which ate the 20 s request budget and failed checks the cluster passed.
	# TLS is still verified per hostname; the wildcard record is checked here instead.
	edge=$(getent ahostsv4 "{{ domain }}" | awk 'NR==1{print $1}')
	wild=$(getent ahostsv4 "smoke-$RANDOM.apps.{{ domain }}" | awk 'NR==1{print $1}')
	if [ -z "$edge" ] || [ "$wild" != "$edge" ]; then
		echo "  FAIL  *.{{ domain }} resolves to '${wild}', the apex to '${edge}'"; exit 1
	fi
	export CURL_HOME; CURL_HOME=$(mktemp -d); trap 'rm -rf "$CURL_HOME"' EXIT
	printf 'resolve = *:443:%s\nresolve = *:80:%s\n' "$edge" "$edge" >"$CURL_HOME/.curlrc"
	JC_REALM="{{ namespace }}" ./scripts/smoke.sh "https://{{ domain }}" "https://idm.{{ domain }}" || rc=1
	# Every public App of the seeds on its own host (T-5774): prod's Gitea-built Apps had no bundle
	# for a week, and nothing read their hosts.
	echo "public apps"
	python3 scripts/smoke-public-apps.py "{{ domain }}" $([ "{{ namespace }}" = dev ] && echo --development) || rc=1
	# A CronJob whose newest run failed (T-4385): a harvest dead since the night is no green smoke.
	echo "cron jobs"
	kubectl -n "{{ namespace }}" get jobs -o json | python3 scripts/failed-jobs.py || rc=1
	# The Portal's edge wave (T-5318): the served edge stays the same when the Portal's write of
	# apisix-standalone-config is refused, so the smoke makes it write once and checks it landed.
	echo "edge wave"
	python3 scripts/smoke-edge-wave.py || rc=1
	# The background map (T-4638): a range request answers 206, and the monthly refresh kept the
	# file younger than 40 days (Last-Modified is the file's own time).
	echo "basemap"
	hdr=$(curl -sS -o /dev/null -D - -m 20 -H 'Range: bytes=0-16383' "https://tiles.{{ domain }}/basemap.pmtiles" 2>&1 | tr -d '\r' || true)
	status=$(printf '%s\n' "$hdr" | awk 'NR == 1 { print $2 }')
	lm=$(printf '%s\n' "$hdr" | sed -n 's/^[Ll]ast-[Mm]odified: //p')
	modified=$( { [ -n "$lm" ] && date -u -d "$lm" +%s; } 2>/dev/null || echo 0)
	age=$(( ($(date -u +%s) - modified) / 86400 ))
	if [ "$status" != 206 ]; then echo "  FAIL  basemap: a range request answered '${status}', not 206"; rc=1
	elif [ "$age" -gt 40 ]; then echo "  FAIL  basemap: the file is ${age} days old, the refresh is overdue"; rc=1
	else echo "  ok    basemap: 206, the file is ${age} days old"; fi
	# The chart renderer (T-4641): the frame that runs a spec may connect nowhere, and CKAN answers
	# CORS to the host page that reads the views.
	echo "viz"
	csp=$(curl -sS -o /dev/null -D - -m 20 "https://viz.{{ domain }}/render.html" 2>&1 | tr -d '\r' | sed -n 's/^[Cc]ontent-[Ss]ecurity-[Pp]olicy: //p')
	cors=$(curl -sS -o /dev/null -D - -m 20 -H "Origin: https://viz.{{ domain }}" "https://opendata.{{ domain }}/api/3/action/status_show" 2>&1 | tr -d '\r' | sed -n 's/^[Aa]ccess-[Cc]ontrol-[Aa]llow-[Oo]rigin: //p')
	case "$csp" in *"connect-src 'none'"*) ;; *) echo "  FAIL  viz: render.html answered no connect-src 'none' ('${csp}')"; rc=1;; esac
	if [ "$cors" != "https://viz.{{ domain }}" ]; then echo "  FAIL  viz: CKAN answered CORS '${cors}' to the renderer"; rc=1
	else echo "  ok    viz: the renderer connects nowhere, CKAN answers its host page"; fi
	# The postgres data volume (T-4414): the broker's history once filled it ~30 GB a week, every
	# smoke green. Every instance of the cluster, wherever its namespace is; no reading fails too.
	echo "postgres data volume"
	# Instances only: the cluster's completed initdb Job pod carries the same cluster label (smoke 13:45Z).
	pods=$(kubectl get pods -A -l cnpg.io/cluster=postgres-cluster,cnpg.io/podRole=instance -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{"\n"}{end}')
	[ -n "$pods" ] || { echo "  FAIL  postgres data: no pod of postgres-cluster"; rc=1; }
	for pod in $pods; do
		kubectl -n "${pod%%/*}" exec "${pod##*/}" -c postgres -- df -P /var/lib/postgresql/data 2>&1 \
			| python3 scripts/disk-full.py --max 85 --label "postgres data of ${pod##*/}" || rc=1
	done
	exit "$rc"

# Verify the dev cluster (see scripts/smoke.sh)
[group('dev cluster')]
dev-smoke:
	#!/usr/bin/env bash
	set -euo pipefail
	just _dev-guard
	rc=0
	just _smoke "{{ dev_domain }}" dev || rc=1
	# A real forge login as the demo people (T-1422): the button can fail with the rest green.
	echo "forge login"
	./scripts/smoke-forge-login.sh "https://{{ dev_domain }}" || rc=1
	# a green full smoke releases what a red per-change apply held (dev-apply-pins, T-6155)
	[ "$rc" -ne 0 ] || kubectl -n dev delete configmap jc-apply-red --ignore-not-found
	exit "$rc"

# The two data sweeps (~20 min of ~1250 count reads and ~1400 link reads), read-only. They left the
# per-apply smoke (T-6148: push to dev under 30 min) and run hourly beside it; prod-smoke and the
# release gate (dev-smoke-full) still run them.
[group('dev cluster')]
_smoke-sweeps domain namespace:
	#!/usr/bin/env bash
	set -euo pipefail
	rc=0
	# Every catalogue dataset and public Endpoint on every interface (T-4716): read-only; the
	# entity count of every dataset first, 6 at once and 400 a minute (T-5768, T-5903), then 50 requests a minute for
	# 10 minutes at most; its table lands in .smoke/.
	echo "catalogue"
	python3 scripts/smoke-catalogue.py "{{ domain }}" "{{ namespace }}" || rc=1
	# Rows of every public Endpoint x type link the dataset of their space and type (T-4802).
	echo "source links"
	python3 scripts/smoke-source-links.py "{{ domain }}" "{{ namespace }}" || rc=1
	exit "$rc"

# The hourly data sweeps of dev (catalogue, source links), off the apply's critical path
[group('dev cluster')]
dev-smoke-sweeps:
	#!/usr/bin/env bash
	set -euo pipefail
	just _dev-guard
	just _smoke-sweeps "{{ dev_domain }}" dev

# Everything dev-smoke and dev-smoke-sweeps check, in one run: the release gate's dev-smoke stage
[group('dev cluster')]
dev-smoke-full:
	#!/usr/bin/env bash
	set -euo pipefail
	rc=0
	just dev-smoke || rc=1
	just _smoke-sweeps "{{ dev_domain }}" dev || rc=1
	exit "$rc"

# T-6110: render dev at <base> (default: the commit jc-release records as applied) and at HEAD,
# sync only the releases whose objects moved, wait for their workloads alone, record, and smoke
# their components (rollouts, routes, edge security headers). T-6155: the per-change path, run for
# each pin commit as it lands; it prints the seconds from the commit to dev running it smoked.
# The plan compares each release's merged values (helmfile write-values) at <base> and HEAD; the
# signature check renders the moved releases alone; a sync of local charts only skips the chart
# repositories (--skip-deps), and the prepare hook stands down (a pin moves no namespace).
# A range with any file besides a components/<c>/images.yaml takes the full way instead:
# `just dev-apply` (scoped by render, T-6135) and `just dev-smoke`. A red rollout or smoke holds
# its releases in the ConfigMap jc-apply-red: the next per-change apply of a held release is
# refused until the full dev-apply and a green dev-smoke clear it. `dry=true` prints the releases
# and their `helmfile diff` only. While the model spend guard holds, agent-runner-proxy runs at 0
# replicas outside helmfile, so a sync would bring it back and reopen model spend: it is left out
# (named on stdout) unless `spend_guard=off` says the guard was lifted.
# Apply one change to dev: only the releases a pin moved, smoked in a minute
[group('dev cluster')]
dev-apply-pins base='' dry='false' spend_guard='on':
	#!/usr/bin/env bash
	set -euo pipefail
	just _dev-guard
	just _dev-retired
	just _dev-assemble
	started=$(date -u +%s)
	committed=$(git log -1 --format=%ct HEAD)
	base="{{ base }}"
	[ -n "$base" ] || base=$(kubectl -n dev get configmap jc-release -o jsonpath='{.data.commit}')
	[ -n "$base" ] || { echo "no applied commit recorded in dev (jc-release); run just dev-apply" >&2; exit 1; }
	# exit 3: the range holds more than pins, so it goes the full way; any other failure stops here
	planned=0
	moved=$(./scripts/apply-pins.py releases dev "$base") || planned=$?
	if [ "$planned" -eq 3 ]; then
		echo "dev-apply-pins: more than pins since ${base:0:12}; the full just dev-apply and just dev-smoke instead"
		[ "{{ dry }}" = true ] && exit 0
		just dev-apply false "{{ spend_guard }}"
		exec just dev-smoke
	fi
	[ "$planned" -eq 0 ] || exit "$planned"
	# one row per moved release: <release> <component> local|remote
	rows=$(printf '%s\n' "$moved" | sed '/^$/d')
	case "{{ spend_guard }}" in
	on)
		if grep -q '^agent-runner-proxy ' <<<"$rows"; then
			echo "skipping agent-runner-proxy: the spend guard keeps it at 0 replicas (spend_guard=off syncs it; once the guard lifts, just dev-apply true off brings it to HEAD)"
			rows=$(sed '/^agent-runner-proxy /d' <<<"$rows")
		fi ;;
	off) ;;
	*) echo "spend_guard is on or off, not '{{ spend_guard }}'" >&2; exit 2 ;;
	esac
	mapfile -t releases < <(awk 'NF {print $1}' <<<"$rows")
	components=$(awk 'NF {print $2}' <<<"$rows" | sort -u)
	# Every moved chart a directory of its component: no chart repository to add, no dependency to build.
	skip_deps=()
	awk 'NF && $3 != "local" {exit 1}' <<<"$rows" && skip_deps=(--skip-deps)
	selectors=()
	for r in "${releases[@]}"; do selectors+=(--selector "name=$r"); done
	echo "pins ${base:0:12}..$(git rev-parse --short=12 HEAD): ${releases[*]:-no release moved}"
	# a release whose last per-change apply went red waits for the full path
	red=$(kubectl -n dev get configmap jc-apply-red --ignore-not-found -o jsonpath='{.data.releases}')
	held=()
	for r in "${releases[@]}"; do
		if grep -qxF "$r" <<<"$red"; then held+=("$r"); fi
	done
	if [ "${#held[@]}" -gt 0 ]; then
		echo "refusing: ${held[*]} went red in a per-change apply (ConfigMap jc-apply-red in dev); fix it, then just dev-apply and a green just dev-smoke clear the hold" >&2
		exit 1
	fi
	if [ "{{ dry }}" = true ]; then
		[ "${#releases[@]}" -eq 0 ] || helmfile -f deployment/helmfile.yaml -e dev diff --concurrency {{helmfile_concurrency}} "${selectors[@]}"
		exit 0
	fi
	rc=0
	if [ "${#releases[@]}" -gt 0 ]; then
		# Every platform digest the synced releases render carries our workflows' signature, or
		# nothing is applied (T-5564): the render of those releases alone, not of all of dev.
		render=$(mktemp)
		trap 'rm -f "$render"' EXIT
		./scripts/render.sh dev "$render" --deployed "${selectors[@]}"
		./scripts/verify-pinned-images.py dev --render "$render" --scoped
		./scripts/release.py start dev || true
		# A pin moves no namespace: the prepare hook (namespaces, mesh annotations) has nothing to do.
		JC_PREPARE_SKIP=pins helmfile -f deployment/helmfile.yaml -e dev sync --concurrency {{helmfile_concurrency}} "${skip_deps[@]}" "${selectors[@]}"
		./scripts/wait-rollouts.sh dev 600 "${releases[@]}" || rc=1
		echo "dev-apply-pins: planned, verified, synced and rolled out in $(( $(date -u +%s) - started )) s"
	fi
	if [ "$rc" -eq 0 ]; then
		./scripts/release.py record dev dev
		for c in $components; do
			just dev-smoke-component "$c" || rc=1
		done
	fi
	took=$(( $(date -u +%s) - committed ))
	if [ "$rc" -ne 0 ]; then
		kubectl -n dev create configmap jc-apply-red --dry-run=client -o yaml \
			--from-literal=releases="$(printf '%s\n' $red "${releases[@]}" | sed '/^$/d' | sort -u)" \
			--from-literal=commit="$(git rev-parse HEAD)" | kubectl apply -f -
		echo "dev-apply-pins: $(git rev-parse --short=12 HEAD) red ${took} s after its commit; held: ${releases[*]}" >&2
		exit "$rc"
	fi
	echo "dev-apply-pins: $(git rev-parse --short=12 HEAD) running on dev and smoked ${took} s after its commit"

# The smoke checks of one component (scripts/smoke-component.sh), after dev-apply-pins
[group('dev cluster')]
dev-smoke-component component:
	./scripts/smoke-component.sh "{{ dev_domain }}" dev "{{ component }}"

# T-5899: after dev-apply of <rev>, every standard (reads and writes), the Portal live sweep and the
# k6 mix at <rate>/s (8: under the edge's 10/s per address, T-5900), and a green Antares weekly sweep
# of the pinned broker commit (T-6151; GH_TOKEN dispatches one when it has none). Credentials only from the
# environment (ANTARES_DIR, NGSILD_TOKEN, GH_TOKEN,
# WRITE_ENDPOINT, the sweep's *_PASSWORD from the secrets mount; ANTARES_DIR at the Antares commit the
# candidate's broker pins); it refuses in seconds when one is missing, and each stage stops after an hour.
# The run holds dev only for the components its remaining stages measure (.hold.json, T-6318): the supervisor's
# pin-apply cron asks `standards-gate.py held` and lands other pins meanwhile; a stage under which a pin it
# measures moved anyway is red. See scripts/standards-gate.py.
# Run the release gate on dev: its green record is what prod-apply asks for
[group('dev cluster')]
release-gate rev='HEAD' rate='8' duration='5m':
	#!/usr/bin/env bash
	set -euo pipefail
	just _dev-guard
	./scripts/standards-gate.py run "{{ rev }}" --rate "{{ rate }}" --duration "{{ duration }}"

# Validate dev against main (T-2799): drift, image pins and signatures, NetworkPolicy probes,
# certificate and backup expiry, Kyverno; the summary is what tasks/file-failures reads
[group('dev cluster')]
dev-validate out='deployment/validate-dev.json':
	#!/usr/bin/env bash
	set -euo pipefail
	just _dev-guard
	just _dev-assemble
	./scripts/validate-dev.py --out "{{ out }}"

# Nightly drift (T-4956): helmfile diff --three-way-merge of dev or smartcity (production) under
# a read-only token (jc-drift-reader, get/list, 30 min). One result per release in <out>; hand it
# to tasks/file-failures, which files one task per drifting release. Never applies anything.
[group('dev cluster')]
drift env out='':
	#!/usr/bin/env bash
	set -euo pipefail
	case "{{ env }}" in
		dev) just _dev-guard ;;
		smartcity) just _prod-guard ;;
		*) echo "drift: environment must be dev or smartcity, not '{{ env }}'" >&2; exit 2 ;;
	esac
	just _dev-assemble
	out="{{ out }}"; out="${out:-deployment/drift-{{ env }}.json}"
	ns=$(kubectl get serviceaccounts -A --field-selector metadata.name=jc-drift-reader -o jsonpath='{.items[0].metadata.namespace}')
	[ -n "$ns" ] || { echo "drift: no jc-drift-reader ServiceAccount on the cluster; apply runtime-policies first" >&2; exit 1; }
	server=$(kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}')
	ca=$(kubectl config view --minify --raw -o jsonpath='{.clusters[0].cluster.certificate-authority-data}')
	token=$(kubectl -n "$ns" create token jc-drift-reader --duration 30m)
	umask 077
	ro=$(mktemp -t drift-kubeconfig.XXXXXX)
	trap 'rm -f "$ro"' EXIT
	cat > "$ro" <<KUBECONFIG
	apiVersion: v1
	kind: Config
	clusters: [{name: c, cluster: {server: "$server", certificate-authority-data: "$ca"}}]
	users: [{name: drift-reader, user: {token: "$token"}}]
	contexts: [{name: drift, context: {cluster: c, user: drift-reader}}]
	current-context: drift
	KUBECONFIG
	unset token
	# Refuse to run with anything that can write: the check reads, it never applies.
	for verb in create patch delete; do
		if [ "$(KUBECONFIG="$ro" kubectl auth can-i "$verb" deployments -A 2>/dev/null)" != no ]; then
			echo "drift: the drift identity can $verb deployments; refusing" >&2; exit 1
		fi
	done
	# Nor anything beyond object reads: nodes/proxy is the kubelet API (exec over a GET).
	for sub in nodes/proxy services/proxy pods/log; do
		if [ "$(KUBECONFIG="$ro" kubectl auth can-i get "$sub" -A 2>/dev/null)" != no ]; then
			echo "drift: the drift identity can get $sub; refusing" >&2; exit 1
		fi
	done
	KUBECONFIG="$ro" ./scripts/validate-dev.py --env "{{ env }}" --skip images,expiry,kyverno,probes --out "$out"

