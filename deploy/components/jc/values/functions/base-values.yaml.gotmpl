{{- $global := .Values.global }}
{{- $jc := .Values.jc.server }}
{{- /* Its realm and gateway are jc's public addresses: idm. and api. in host mode, the instance's
       one host in slug mode (kaisatsu under /login, the gateway's /api/endpoint at the root). */}}
{{- $host := eq (dig "mode" "slug" $jc) "host" }}
{{- $issuerBase := printf "https://idm.%s" $global.domain }}
{{- $gateway := printf "https://api.%s" $global.domain }}
{{- if not $host }}
{{- $one := printf "https://%s.%s" (required "jc.functions: slug mode needs jc.server.subDomain" $jc.subDomain) $global.domain }}
{{- $issuerBase = printf "%s/login" $one }}
{{- $gateway = $one }}
{{- end }}
{{- $realm := dig "realmImport" "realm" "" $jc }}
{{- if not $realm }}
{{- fail "jc.functions: name jc.server.realmImport.realm, the realm whose portal-api tokens it accepts" }}
{{- end }}
# Checklist:
# - [x] Containers run as non-root with `readOnlyRootFilesystem`
# - [x] Health probes -> /healthz
# - [x] Standard labels, named port 8080, no API token
# - [ ] Ingress with TLS -> not applicable, reached from jc alone

fullnameOverride: jc-functions
nameOverride: jc-functions

{{- /* The runtime ships in jc's own image (T-7774, bins/jc/Dockerfile): jc-dev runs jc-dev's jc pin.
       Elsewhere `functions` stays the platform image until that environment's jc pin carries
       /usr/local/bin/jc-functions; then @prod-deployer points `functions` at jc's pin too. */}}
{{- $images := .Values.images.jc.functions }}
{{- if eq .Environment.Name "jc-dev" }}
{{- $images = index .Values.images "jc" "serverJcDev" | default dict }}
{{- end }}
image:
  repository: {{ $images.repository }}
  tag: {{ $images.tag | quote }}
  digest: {{ $images.digest }}
  pullPolicy: IfNotPresent

# The image's entrypoint is jc (the platform image's: the gateway); the runtime is the binary beside it.
command:
  - /usr/local/bin/jc-functions

containerPort: 8080

service:
  enabled: true
  type: ClusterIP
  port: 8080
  targetPort: 8080
  name: http

probes:
  readiness:
    path: /healthz
    periodSeconds: 5
    timeoutSeconds: 3
    failureThreshold: 3
  liveness:
    path: /healthz
    periodSeconds: 15
    timeoutSeconds: 3
    failureThreshold: 3
    initialDelaySeconds: 5

{{- with (dig "edgeAddress" "" $jc) }}
# Until DNS moves, idm. and api. resolve to the old installation: pin them to this cluster's edge.
hostAliases:
  - ip: {{ . | quote }}
    hostnames:
      - idm.{{ $global.domain }}
      - api.{{ $global.domain }}
{{- end }}

# No credential: the runtime verifies jc's Portal token (audience jc-functions, azp portal-api, the
# realm's jc-functions-audience mapper) and passes each caller's own token to jc's gateway (SDK-23).
env:
  JC_FUNCTIONS_BIND: "0.0.0.0:8080"
  JC_OIDC_ISSUER: "{{ $issuerBase }}/realms/{{ $realm }}"
  JC_OIDC_JWKS_URL: "{{ $issuerBase }}/realms/{{ $realm }}/protocol/openid-connect/certs"
  JC_FUNCTIONS_CALLER: portal-api
  JC_FUNCTIONS_ASSISTANT_CALLER: jc-assistant
  JC_FUNCTIONS_AUDIENCE: jc-functions
  JC_GATEWAY_URL: "{{ $gateway }}"

podSecurityContext:
  {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 2 }}

securityContext:
  {{ .Values.securityDefaults.securityContext | toYaml | nindent 2 }}

serviceMesh:
  enabled: {{ and ($global.serviceMesh.enable | default false) (eq ($global.serviceMesh.type | default "") "linkerd") }}
