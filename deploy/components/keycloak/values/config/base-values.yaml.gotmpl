---
{{- $this := .Values.keycloak.config }}
{{- $global := .Values.global }}
# Checklist:
# - [ ] Containers run as non-root with `readOnlyRootFilesystem` -> does not work yet with config-cli
# - [x] Health probes -> not applicable for jobs
# - [ ] Graceful shutdown
# - [ ] Standard labels
# - [x] ServiceAccount with least privilege where required -> keycloak-app-keycloakx, no token mounted
# - [ ] Named ports
# - [ ] Ingress with TLS

containerSecurityContext:
  {{ .Values.securityDefaults.securityContext | toYaml | nindent 2 }}

securityContext:
  {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 2 }}

# The chart can only name a ServiceAccount, it cannot create one and has no
# `automountServiceAccountToken` key, so the Job would otherwise run under the namespace's
# `default` account with its token mounted (TS-19, CC-12). Keycloak's own account sits in the
# same namespace and already sets `automountServiceAccountToken: false`, so naming it hands
# this Job no token at all -- which is what it wants, because it configures Keycloak over
# HTTP and never calls the API server. The release fullname is hardcoded the same way the
# `KEYCLOAK_URL` Service name below is.
serviceAccount: keycloak-app-keycloakx

image:
  {{- with .Values.images.keycloak.configCli }}
  repository: {{ .repository }}
  tag: {{ .tag }}@{{ .digest }}
  {{- end }}
backoffLimit: 2
# resources are hardcoded since config-cli is a job which won't need more resources, even when the platform scales up
resources:
  limits:
    cpu: "400m"
    memory: "1024Mi"
  requests:
    cpu: "100m"
    memory: "512Mi"

env:
  KEYCLOAK_AVAILABILITYCHECK_ENABLED: "true"
  KEYCLOAK_AVAILABILITYCHECK_RETRIES: 10s
  KEYCLOAK_URL: http://keycloak-app-keycloakx-http.{{ .Values.keycloak.app.namespace }}.svc.cluster.local:80{{ .Values.keycloak.app.pathPrefix | trimSuffix "/" }}
  KEYCLOAK_USER: "{{ .Values.keycloak.app.admin.username }}"
  IMPORT_FILES_LOCATIONS: /config/*
  IMPORT_VARSUBSTITUTION_ENABLED: "true"
  IMPORT_VARSUBSTITUTION_NESTED: "false"

existingSecret: keycloak-admin-user
existingSecretKey: password

{{- $smtp := $this.smtp | default dict }}
extraEnv:
{{- if $smtp.enabled }}
{{- range $var, $key := dict "SMTP_HOST" "host" "SMTP_PORT" "port" "SMTP_FROM" "from" "SMTP_USER" "user" "SMTP_PASSWORD" "password" }}
  - name: {{ $var }}
    valueFrom:
      secretKeyRef:
        name: {{ $smtp.existingSecret | default "keycloak-smtp" }}
        key: {{ $key }}
{{- end }}
{{- end }}
  {{- if $this.initialUser }}
  - name: USER_PASSWORD_INITIAL
    valueFrom:
      secretKeyRef:
        name: keycloak-user-initial
        key: password
  {{- end }}
  {{- range $name, $user := $this.demoUsers | default dict }}
  {{- /* The presenter's password is copied from dev as stored (T-6542): no Secret, no variable. */}}
  {{- if ne (index $user "credential" | default "") "copied" }}
  - name: USER_PASSWORD_{{ $name | upper | replace "." "_" }}
    valueFrom:
      secretKeyRef:
        name: keycloak-user-{{ $name | replace "." "-" }}
        key: password
  {{- /* The TOTP seed of a demo person who must sign in with a second factor (T-5120), generated
         beside the password (defaults/environment/secrets.yaml.gotmpl); the journeys read it from
         the same Secret. The role list is the composites of `mfa-required` below. */}}
  {{- if and (not (index $user "enrols")) (or (has "platform-admin" ($user.realmRoles | default list)) (has "mfa-required" ($user.realmRoles | default list)) (and (ne (toString $global.approverMfa) "false") (has "portal-approver" ($user.realmRoles | default list)))) }}
  - name: USER_TOTP_{{ $name | upper | replace "." "_" }}
    valueFrom:
      secretKeyRef:
        name: keycloak-user-{{ $name | replace "." "-" }}
        key: totp
  {{- end }}
  {{- end }}
  {{- end }}
  {{- range $clientId, $client := .Values.keycloakClients }}
  {{- $rawValues := index $client "rawValues" | default dict }}
  {{- $isPublicClient := false }}
  {{- if hasKey $rawValues "publicClient" }}
  {{- $isPublicClient = index $rawValues "publicClient" }}
  {{- end }}
  {{- if and (not $isPublicClient) (not (index $client "federated")) }}
  - name: CLIENT_SECRET_{{ $clientId | upper | replace "-" "_" }}
    valueFrom:
      secretKeyRef:
        name: {{ printf "keycloak-client-%s" $clientId }}
        key: client-secret
  {{- end }}
  {{- end }}

config:
  {{ $global.instanceSlug }}:
    inline:
      id: {{ $global.instanceSlug }}
      realm: "{{ $global.instanceSlug }}"
      # What the login pages call the organization (PF-90): its name from the branding
      # block, never the realm id.
      {{- $branding := $global.branding | default dict }}
      displayName: {{ $branding.organisation | default $branding.instanceName | default "joinedcontext" | quote }}
      notBefore: 0
      # TR-03187 AR-11: Use ES256 for token signatures
      defaultSignatureAlgorithm: ES256
      # TR-03187 AR-6 (T-5568): a refresh token works once; a replayed one ends the session.
      revokeRefreshToken: true
      refreshTokenMaxReuse: 0
      accessTokenLifespan: 300
      accessTokenLifespanForImplicitFlow: 900
      # TR-03187 AR-6/W-8: 60min idle timeout
      ssoSessionIdleTimeout: 3600
      ssoSessionMaxLifespan: 36000
      ssoSessionIdleTimeoutRememberMe: 0
      ssoSessionMaxLifespanRememberMe: 0
      # An offline token lapses 30 days unused and 60 days after its login however often it is
      # used (T-5568); only the MCP connector clients and the CIMD clients may ask for one
      # (optionalClientScopes, defaultOptionalClientScopes, T-6301).
      offlineSessionIdleTimeout: 2592000
      offlineSessionMaxLifespanEnabled: true
      offlineSessionMaxLifespan: 5184000
      clientSessionIdleTimeout: 0
      clientSessionMaxLifespan: 0
      clientOfflineSessionIdleTimeout: 0
      clientOfflineSessionMaxLifespan: 0
      accessCodeLifespan: 60
      accessCodeLifespanUserAction: 300
      accessCodeLifespanLogin: 1800
      actionTokenGeneratedByAdminLifespan: 43200
      actionTokenGeneratedByUserLifespan: 300
      # TR-03187 AR-11: Keycloak 26 defaults to Argon2id for password hashing — no config override needed
      # TR-03187 AUT-9: Keycloak 26 account console requires password re-entry for sensitive profile changes (incl. email) by default
      # TR-03187 AR-13: Certificate chain validation handled by Linkerd mTLS at infrastructure level — no realm config needed
      enabled: true
      # Fine-grained admin permissions (v2): what narrows the Portal's client administration to
      # the clients it manages; the keycloak adminPermissions part writes the permissions after
      # this import (T-2725).
      adminPermissionsEnabled: true
      sslRequired: external
      registrationAllowed: false
      registrationEmailAsUsername: true
      rememberMe: false
      verifyEmail: true
      loginWithEmailAllowed: true
      duplicateEmailsAllowed: false
      resetPasswordAllowed: true
      editUsernameAllowed: true
      # TR-03187: Brute force protection enabled, lockout after 10 attempts. The 10th wrong
      # password within 12 h locks the account for 60 s, each further 10 add 60 s up to 15 min;
      # a login faster than 1 s after the last one waits 60 s (T-5120, components/keycloak/README.md).
      bruteForceProtected: true
      permanentLockout: false
      maxFailureWaitSeconds: 900
      minimumQuickLoginWaitSeconds: 60
      waitIncrementSeconds: 60
      quickLoginCheckMilliSeconds: 1000
      maxDeltaTimeSeconds: 43200
      failureFactor: 10
      defaultRoles:
        - offline_access
        - uma_authorization
      # TR-03187 AUT-7: Password policy — min 12 chars, upper, lower, digit; never the username
      # or e-mail, none of the last 5 (T-5120).
      passwordPolicy: "length(12) and upperCase(1) and lowerCase(1) and digits(1) and notUsername(undefined) and notEmail(undefined) and passwordHistory(5)"
      requiredCredentials:
        - password
      otpPolicyType: totp
      # TR-03187 AR-11: Use SHA256 for OTP
      otpPolicyAlgorithm: HmacSHA256
      otpPolicyInitialCounter: 0
      otpPolicyDigits: 6
      otpPolicyLookAheadWindow: 1
      otpPolicyPeriod: 30
      otpSupportedApplications:
        - FreeOTP
        - Google Authenticator
      webAuthnPolicyRpEntityName: keycloak
      webAuthnPolicySignatureAlgorithms:
        - ES256
      webAuthnPolicyRpId: ""
      webAuthnPolicyAttestationConveyancePreference: not specified
      webAuthnPolicyAuthenticatorAttachment: not specified
      webAuthnPolicyRequireResidentKey: not specified
      webAuthnPolicyUserVerificationRequirement: not specified
      webAuthnPolicyCreateTimeout: 0
      webAuthnPolicyAvoidSameAuthenticatorRegister: false
      webAuthnPolicyAcceptableAaguids: []
      webAuthnPolicyPasswordlessRpEntityName: keycloak
      webAuthnPolicyPasswordlessSignatureAlgorithms:
        - ES256
      webAuthnPolicyPasswordlessRpId: ""
      webAuthnPolicyPasswordlessAttestationConveyancePreference: not specified
      webAuthnPolicyPasswordlessAuthenticatorAttachment: not specified
      webAuthnPolicyPasswordlessRequireResidentKey: not specified
      webAuthnPolicyPasswordlessUserVerificationRequirement: not specified
      webAuthnPolicyPasswordlessCreateTimeout: 0
      webAuthnPolicyPasswordlessAvoidSameAuthenticatorRegister: false
      webAuthnPolicyPasswordlessAcceptableAaguids: []
      browserSecurityHeaders:
        contentSecurityPolicyReportOnly: ""
        xContentTypeOptions: nosniff
        xRobotsTag: none
        xFrameOptions: SAMEORIGIN
        contentSecurityPolicy: frame-src 'self'; frame-ancestors 'self'; object-src 'none';
        xXSSProtection: 1; mode=block
        strictTransportSecurity: max-age=31536000; includeSubDomains
{{- if $smtp.enabled }}
      smtpServer:
        # The values come from the Secret above through config-cli variable substitution.
        password: "$(SMTP_PASSWORD)"
        host: "$(SMTP_HOST)"
        port: "$(SMTP_PORT)"
        from: "$(SMTP_FROM)"
        user: "$(SMTP_USER)"
        starttls: "true"
        auth: "true"
        ssl: "false"
{{- end }}
      # The joinedcontext theme (UI-82, components/keycloak/charts/theme) for the login pages
      # and the account console (T-4203: the Portal's logo, colours and a way back to it); the
      # admin and e-mail pages stay Keycloak's own.
      loginTheme: joinedcontext
      accountTheme: joinedcontext
      adminTheme: keycloak
      emailTheme: keycloak
      eventsEnabled: true
      eventsExpiration: 2592000
      eventsListeners:
        - jboss-logging
      enabledEventTypes:
        - SEND_RESET_PASSWORD
        - UPDATE_CONSENT_ERROR
        - GRANT_CONSENT
        - VERIFY_PROFILE_ERROR
        - REMOVE_TOTP
        - REVOKE_GRANT
        - UPDATE_TOTP
        - LOGIN_ERROR
        - CLIENT_LOGIN
        - RESET_PASSWORD_ERROR
        - IMPERSONATE_ERROR
        - CODE_TO_TOKEN_ERROR
        - CUSTOM_REQUIRED_ACTION
        - OAUTH2_DEVICE_CODE_TO_TOKEN_ERROR
        - RESTART_AUTHENTICATION
        - IMPERSONATE
        - UPDATE_PROFILE_ERROR
        - LOGIN
        - OAUTH2_DEVICE_VERIFY_USER_CODE
        - UPDATE_PASSWORD_ERROR
        - CLIENT_INITIATED_ACCOUNT_LINKING
        - TOKEN_EXCHANGE
        - AUTHREQID_TO_TOKEN
        - LOGOUT
        - REGISTER
        - DELETE_ACCOUNT_ERROR
        - CLIENT_REGISTER
        - IDENTITY_PROVIDER_LINK_ACCOUNT
        - DELETE_ACCOUNT
        - UPDATE_PASSWORD
        - CLIENT_DELETE
        - FEDERATED_IDENTITY_LINK_ERROR
        - IDENTITY_PROVIDER_FIRST_LOGIN
        - CLIENT_DELETE_ERROR
        - VERIFY_EMAIL
        - CLIENT_LOGIN_ERROR
        - RESTART_AUTHENTICATION_ERROR
        - EXECUTE_ACTIONS
        - REMOVE_FEDERATED_IDENTITY_ERROR
        - TOKEN_EXCHANGE_ERROR
        - PERMISSION_TOKEN
        - SEND_IDENTITY_PROVIDER_LINK_ERROR
        - EXECUTE_ACTION_TOKEN_ERROR
        - SEND_VERIFY_EMAIL
        - OAUTH2_DEVICE_AUTH
        - EXECUTE_ACTIONS_ERROR
        - REMOVE_FEDERATED_IDENTITY
        - OAUTH2_DEVICE_CODE_TO_TOKEN
        - IDENTITY_PROVIDER_POST_LOGIN
        - IDENTITY_PROVIDER_LINK_ACCOUNT_ERROR
        - OAUTH2_DEVICE_VERIFY_USER_CODE_ERROR
        - UPDATE_EMAIL
        - REGISTER_ERROR
        - REVOKE_GRANT_ERROR
        - EXECUTE_ACTION_TOKEN
        - LOGOUT_ERROR
        - UPDATE_EMAIL_ERROR
        - CLIENT_UPDATE_ERROR
        - AUTHREQID_TO_TOKEN_ERROR
        - UPDATE_PROFILE
        - CLIENT_REGISTER_ERROR
        - FEDERATED_IDENTITY_LINK
        - SEND_IDENTITY_PROVIDER_LINK
        - SEND_VERIFY_EMAIL_ERROR
        - RESET_PASSWORD
        - CLIENT_INITIATED_ACCOUNT_LINKING_ERROR
        - OAUTH2_DEVICE_AUTH_ERROR
        - UPDATE_CONSENT
        - REMOVE_TOTP_ERROR
        - VERIFY_EMAIL_ERROR
        - SEND_RESET_PASSWORD_ERROR
        - CLIENT_UPDATE
        - CUSTOM_REQUIRED_ACTION_ERROR
        - IDENTITY_PROVIDER_POST_LOGIN_ERROR
        - UPDATE_TOTP_ERROR
        - CODE_TO_TOKEN
        - VERIFY_PROFILE
        - GRANT_CONSENT_ERROR
        - IDENTITY_PROVIDER_FIRST_LOGIN_ERROR
      adminEventsEnabled: true
      adminEventsDetailsEnabled: true
      internationalizationEnabled: true
      # The four languages of the Portal and of the login theme (UI-82); the Portal passes
      # its own as ui_locales.
      supportedLocales:
        - en
        - sk
        - cs
        - de
      defaultLocale: en
      # TR-03187 AUT-2: Custom browser flow with conditional 2FA
      browserFlow: custom browser
      registrationFlow: registration
      # The password grant (directAccessGrantsEnabled clients, e.g. apisix-gateway) asks the same
      # second factor as the browser (T-5120); Keycloak's built-in "direct grant" asks it only of
      # people who enrolled one.
      directGrantFlow: custom direct grant
      resetCredentialsFlow: reset credentials
      clientAuthenticationFlow: clients
      dockerAuthenticationFlow: docker auth
      attributes:
        # T-5567: the step-up subflow's level 2 is the `acr` "mfa", which a login asks with
        # `acr_values=mfa` and the Portal reads before every decision.
        acr.loa.map: '{"pwd":1,"mfa":2}'
        clientOfflineSessionMaxLifespan: "0"
        clientSessionIdleTimeout: "0"
        clientSessionMaxLifespan: "0"
        clientOfflineSessionIdleTimeout: "0"
      userManagedAccessAllowed: false
      # TR-03187 AR-11: ES256 token signing by default (defaultSignatureAlgorithm above).
      # Explicitly declare the realm key providers so keycloak-config-cli manages them
      # authoritatively.
      components:
        org.keycloak.keys.KeyProvider:
          # ES256 signing key — the default signature provider, highest priority.
          - name: ecdsa-generated
            providerId: ecdsa-generated
            config:
              priority:
                - "100"
              enabled:
                - "true"
              active:
                - "true"
              ecdsaEllipticCurveKey:
                - "P-256"
          # RS256 signing key, active at a lower priority than the ES256 key: the realm
          # default stays ES256 and only a client that asks for RS256 by per-client override
          # (`access.token.signed.response.alg`, `id.token.signed.response.alg`) is signed
          # with it. The one that does is `edge`, the APISIX openid-connect client of the edge
          # login: lua-resty-openidc verifies RS- and HS-family signatures only (ADR-N-019,
          # AP-27, T-0252). 4096 bits: BSI TR-02102-1 asks for RSA moduli of 3000 bits or more.
          - name: rsa-generated
            providerId: rsa-generated
            config:
              priority:
                - "50"
              enabled:
                - "true"
              active:
                - "true"
              algorithm:
                - "RS256"
              keySize:
                - "4096"
          # Disable the auto-generated HS512 signing key.
          - name: hmac-generated
            providerId: hmac-generated
            config:
              priority:
                - "-100"
              enabled:
                - "false"
              active:
                - "false"
              algorithm:
                - "HS512"
          # Keep RSA-OAEP encryption key (use=enc, not used for token signatures).
          - name: rsa-enc-generated
            providerId: rsa-enc-generated
            config:
              priority:
                - "100"
              enabled:
                - "true"
              active:
                - "true"
              algorithm:
                - "RSA-OAEP"
          # Keep AES encryption key (use=enc, not used for token signatures).
          - name: aes-generated
            providerId: aes-generated
            config:
              priority:
                - "100"
              enabled:
                - "true"
              active:
                - "true"
      # The Portal MCP route accepts a bearer whose `aud` names the Portal (AG-60, RFC 9728,
      # docs Architecture/07 §1). An MCP client asks for this optional scope on the
      # `mcp-mobile` or `edge` client and its token gains the audience; nothing else on the
      # token changes. The scope stays optional until RFC 8707 resource indicators land.
      # A client that signs in by its client id URL (CIMD: claude.ai, Claude Code, VS Code) is
      # created on its first login with the realm's default scopes; of the optional ones it may
      # ask only for `connector` (T-5954) and `offline_access`, which claude.ai adds to every
      # sign-in for its refresh token (T-6301): the offline session lapses by the realm's
      # offlineSession* settings above, and the Portal still refuses a revoked or expired
      # connector on every /c call. Every keycloak-config-cli client below and every client the
      # Portal makes carries its own list, so this list reaches the CIMD clients alone.
      defaultOptionalClientScopes:
        - connector
        - offline_access
      # CIMD (T-5954, ADR-N-064 §3.3): a client id that is an https URL on one of these hosts is
      # fetched, and its document's exact redirect URIs are the only ones it gets. The executor
      # checks every URI of a document: the loopback hosts are callbacks of Claude Code and VS
      # Code and code.visualstudio.com holds VS Code's logo; none is a client id host, because
      # the policy condition admits only the two vendor hosts. No dynamic registration exists beside it.
      clientProfiles:
        profiles:
          - name: cimd
            description: Client ID Metadata Documents of the known AI clients
            executors:
              - executor: client-id-metadata-document
                configuration:
                  cimd-allow-permitted-domains:
                    [claude.ai, vscode.dev, code.visualstudio.com, localhost, 127.0.0.1]
                  # claude.ai's document lists the jwt-bearer grant beside the code flow; the
                  # client stays public and gets only the code flow.
                  accept-public-client-with-confidential-client-only-grant: true
      clientPolicies:
        policies:
          - name: cimd
            description: Client ids that are https URLs of the known AI clients
            enabled: true
            conditions:
              - condition: client-id-uri
                configuration:
                  client-id-uri-scheme: [https]
                  client-id-uri-allow-permitted-domains: [claude.ai, vscode.dev]
            profiles: [cimd]
      clientScopes:
        # One Portal connector (T-5954, ADR-N-064 §3.3): `connector:{id}` names the connector the
        # token is for, and the mappers name the connectors' door and `portal-api`, the client
        # that exchanges the token for an Endpoint read (RFC 8693 wants it in `aud`). Keycloak
        # 26.8 mints no audience per connector (resource indicators match a static list only),
        # so the Portal takes a token at /c/{id} only when its one `connector:` scope is that id,
        # and refuses a token with any `connector:` scope on every other route.
        - name: connector
          description: One AI connector you created in the Portal
          protocol: openid-connect
          attributes:
            is.parameterized.scope: 'true'
            parameterized.scope.type: custom
            parameterized.scope.regexp: '[a-z2-7]{26}'
            include.in.token.scope: 'true'
            display.on.consent.screen: 'true'
            consent.screen.text: Use one AI connector you created in the Portal, with the rights you gave it
          protocolMappers:
            - name: portal-connectors-audience
              protocol: openid-connect
              protocolMapper: oidc-audience-mapper
              consentRequired: false
              config:
                included.custom.audience: portal-connectors
                access.token.claim: 'true'
                id.token.claim: 'false'
            - name: portal-api-audience
              protocol: openid-connect
              protocolMapper: oidc-audience-mapper
              consentRequired: false
              config:
                included.client.audience: portal-api
                access.token.claim: 'true'
                id.token.claim: 'false'
            # A CIMD client is created with no role scope (fullScopeAllowed false), so its token
            # carries no realm roles: these two put back the groups and the sign-in steps the
            # Portal decides with. A right held only as a realm role stays out (fails closed).
            - name: groups
              protocol: openid-connect
              protocolMapper: oidc-group-membership-mapper
              consentRequired: false
              config:
                claim.name: groups
                full.path: 'true'
                access.token.claim: 'true'
                id.token.claim: 'false'
                userinfo.token.claim: 'false'
            {{- range $claim := list "jc_org" "jc_groups" }}
            - name: {{ $claim }}
              protocol: openid-connect
              protocolMapper: oidc-usermodel-attribute-mapper
              consentRequired: false
              config:
                user.attribute: {{ $claim }}
                claim.name: {{ $claim }}
                jsonType.label: String
                multivalued: 'true'
                aggregate.attrs: 'true'
                access.token.claim: 'true'
                id.token.claim: 'false'
                userinfo.token.claim: 'false'
            {{- end }}
            - name: amr
              protocol: openid-connect
              protocolMapper: oidc-amr-mapper
              consentRequired: false
              config:
                access.token.claim: 'true'
                id.token.claim: 'false'
                introspection.token.claim: 'true'
        - name: mcp:portal
          description: Audience of the Portal MCP server at /api/v1/mcp
          protocol: openid-connect
          attributes:
            include.in.token.scope: 'true'
            display.on.consent.screen: 'false'
          protocolMappers:
            - name: portal-api-audience
              protocol: openid-connect
              protocolMapper: oidc-audience-mapper
              consentRequired: false
              config:
                included.client.audience: portal-api
                access.token.claim: 'true'
                id.token.claim: 'false'
        # The hub's audience in the token the Portal exchanges a person's token for, to read one
        # Endpoint as them (T-6063, API/14 §4.2): Keycloak's standard token exchange hands out
        # only an audience a scope of the requester maps, so the Portal asks for this one beside
        # `endpoint:{slug}`. Optional on `portal-api` alone; the gateway admits the hub audience
        # only together with an `endpoint:` scope, so on its own it reaches nothing.
        - name: gateway-hub
          description: Audience of the MCP hub in the Portal's exchanged token for one Endpoint
          protocol: openid-connect
          attributes:
            include.in.token.scope: 'false'
            display.on.consent.screen: 'false'
          protocolMappers:
            - name: mcp-hub-audience
              protocol: openid-connect
              protocolMapper: oidc-audience-mapper
              consentRequired: false
              config:
                included.client.audience: mcp-hub
                access.token.claim: 'true'
                id.token.claim: 'false'
      # Every Endpoint the person may read, through the MCP hub (T-4114, ADR-N-025 4b, EP-88): a
      # default scope of `mcp-hub` only, shown on its consent screen, so one login hands a
      # connector what the person's own session reads and nothing more. The gateway still
      # decides each call by the Endpoint's Policy; the `endpoint:{slug}` scopes stay narrower.
        - name: endpoint:*
          description: Every Endpoint you may read, through the MCP hub
          protocol: openid-connect
          attributes:
            include.in.token.scope: 'true'
            display.on.consent.screen: 'true'
            consent.screen.text: Read every dataset and Endpoint you may read, through one AI connector
        {{- /* A read across brokers (ADR-N-047 §2.4, PF-113, PF-114, T-3999): the gateway
               exchanges the caller's token for one naming only the brokers the space's
               `identity: caller` members live on. One optional scope per broker, `main`
               included, holds that broker's audience; only the context-gateway client may
               request them (below), so no default token of any client carries a broker
               audience. */}}
        {{- if has "context-broker" $.Values.components }}
        {{- range $b := concat (list (dict "name" "main")) ($global.contextBrokers | default list) }}
        - name: context-broker-{{ $b.name }}
          description: Audience of the Context Broker {{ $b.name }}, requested only in the gateway's token exchange
          protocol: openid-connect
          attributes:
            include.in.token.scope: 'false'
            display.on.consent.screen: 'false'
          protocolMappers:
            - name: context-broker-{{ $b.name }}-audience
              protocol: openid-connect
              protocolMapper: oidc-audience-mapper
              consentRequired: false
              config:
                included.custom.audience: context-broker-{{ $b.name }}
                access.token.claim: 'true'
                id.token.claim: 'false'
        {{- end }}
        {{- end }}
      # Machine identities (jcctl, pipelines, connector) are Keycloak service accounts
      # created from ServiceAccount manifests. The only realm users are the demo logins of
      # the development profile (keycloak.config.demoUsers); their passwords are the
      # cluster-generated Secrets substituted by keycloak-config-cli at import time.
      users:
        {{- /* A confidential client's service account is a realm user named
               `service-account-{clientId}`; a client role is mapped onto that user and never
               onto the client, so a client that needs one declares it and the user appears
               here. The Portal's is the only one so far: it creates and retires the OIDC
               client of every app on demand (AP-27). */}}
        {{- $serviceAccounts := dict }}
        {{- range $clientId, $client := .Values.keycloakClients }}
        {{- if index $client "serviceAccountClientRoles" }}
        {{- $_ := set $serviceAccounts $clientId (index $client "serviceAccountClientRoles") }}
        {{- end }}
        {{- end }}
        {{- range $clientId, $roles := $serviceAccounts }}
        - username: service-account-{{ $clientId }}
          enabled: true
          serviceAccountClientId: {{ $clientId }}
          clientRoles:
            {{- toYaml $roles | nindent 12 }}
        {{- end }}
        {{- range $name, $user := $this.demoUsers | default dict }}
        {{- /* `registrationEmailAsUsername` is set above, so Keycloak stores the email as the
               username. Seeding a different username creates the user once and then aborts
               every later import with "username and email is different while 'email as
               username' is enabled", leaving the account without a password (T-0366). */}}
        - username: {{ $name }}@{{ $global.orgDomain }}
          enabled: true
          emailVerified: true
          email: {{ $name }}@{{ $global.orgDomain }}
          firstName: {{ $user.firstName | quote }}
          lastName: {{ $user.lastName | quote }}
          requiredActions: []
          {{- if eq (index $user "credential" | default "") "copied" }}
          {{- /* No `credentials`: keycloak-config-cli then leaves the copied one alone (T-6542). */}}
          {{- else }}
          credentials:
            - type: password
              value: "$(USER_PASSWORD_{{ $name | upper | replace "." "_" }})"
              temporary: false
            {{- if and (not (index $user "enrols")) (or (has "platform-admin" ($user.realmRoles | default list)) (has "mfa-required" ($user.realmRoles | default list)) (and (ne (toString $global.approverMfa) "false") (has "portal-approver" ($user.realmRoles | default list)))) }}
            {{- /* Keycloak keeps an OTP secret as the text itself and hashes its UTF-8 bytes; the
                   journeys compute the code from the same text (T-5120). The fixed id makes a
                   re-import skip the credential it already holds; without one Keycloak creates it
                   again and answers 409 for the duplicate label, so any later realm change failed
                   (T-5214). */}}
            {{- $otpId := sha256sum (printf "%s:%s@%s:otp" $global.instanceSlug $name $global.orgDomain) }}
            - type: otp
              id: {{ printf "%s-%s-%s-%s-%s" (substr 0 8 $otpId) (substr 8 12 $otpId) (substr 12 16 $otpId) (substr 16 20 $otpId) (substr 20 32 $otpId) }}
              userLabel: journey seed
              secretData: '{"value":"$(USER_TOTP_{{ $name | upper | replace "." "_" }})"}'
              credentialData: '{"subType":"totp","digits":6,"counter":0,"period":30,"algorithm":"HmacSHA256"}'
            {{- end }}
          {{- end }}
          {{- /* The people Job creates each person by a partial import, which grants no default
                 roles, and the import keeps only the roles listed here (it leaves the realm's
                 default composite alone). So the composite is listed: without it a person holds
                 no offline_access and every refresh-token sign-in (claude.ai) fails (T-6301). */}}
          realmRoles:
            {{- toYaml (prepend ($user.realmRoles | default list) (printf "default-roles-%s" $global.instanceSlug)) | nindent 12 }}
          {{- /* `platformReaders: false` keeps a test person out of the default group (T-4911). */}}
          {{- $readers := ne (toString (index $user "platformReaders")) "false" }}
          {{- $groups := concat (ternary (list "platform-readers") (list) $readers) (index $user "groups" | default list) }}
          groups:
            {{- if not $groups }} []{{ end }}
            {{- range $groups }}
            - /{{ . }}
            {{- end }}
        {{- end }}
        {{- with $this.initialUser }}
        {{- /* The owner's account of a production realm (T-4678): the only human at start, with the
               demo steward's roles and groups; its password is the cluster-generated Secret
               keycloak-user-initial, rotated like every other generated Secret. */}}
        - username: {{ .email }}
          enabled: true
          emailVerified: true
          email: {{ .email }}
          requiredActions: []
          credentials:
            - type: password
              value: "$(USER_PASSWORD_INITIAL)"
              temporary: false
          realmRoles:
            {{- toYaml (prepend (.realmRoles | default list) (printf "default-roles-%s" $global.instanceSlug)) | nindent 12 }}
          groups:
            - /platform-readers
            {{- range (.groups | default list) }}
            - /{{ . }}
            {{- end }}
        {{- end }}
        {{- if and (not ($this.demoUsers | default dict)) (not $serviceAccounts) (not $this.initialUser) }}
        []
        {{- end }}
      clients:
        {{- range $clientId, $client := .Values.keycloakClients }}
        {{- /* Host of the client. `subdomain: ""` puts the client on the apex domain
               (the portal and everything else served from https://{host}); omitting
               `subdomain` keeps the historical default of a subdomain named after the
               client id. */}}
        {{- $host := $global.domain }}
        {{- if hasKey $client "subdomain" }}
        {{- if $client.subdomain }}
        {{- $host = printf "%s.%s" $client.subdomain $global.domain }}
        {{- end }}
        {{- else }}
        {{- $host = printf "%s.%s" $clientId $global.domain }}
        {{- end }}
        {{- /* `index` and not `.redirectPath`: a client that logs nobody in declares no
               redirect path at all, and a field access on a map without the key stops the
               whole render (T-0866). */}}
        {{- $redirectPath := index $client "redirectPath" | default "/*" }}
        {{- /* Build the redirect URI list: start with the primary redirectPath, then append any additionalRedirectPaths */}}
        {{- $redirectUris := list (printf "https://%s%s" $host $redirectPath) }}
        {{- range (index $client "additionalRedirectPaths" | default list) }}
        {{- $redirectUris = append $redirectUris (printf "https://%s%s" $host .) }}
        {{- end }}
        {{- /* Redirect URIs on another host of the platform domain: the edge client logs
               people in on the Portal host and on the apex (ADR-N-019, AP-27). An empty
               subdomain is the apex. */}}
        {{- range (index $client "additionalRedirectUris" | default list) }}
        {{- $uriHost := $global.domain }}
        {{- if index . "subdomain" }}
        {{- $uriHost = printf "%s.%s" (index . "subdomain") $global.domain }}
        {{- end }}
        {{- $redirectUris = append $redirectUris (printf "https://%s%s" $uriHost (index . "path")) }}
        {{- end }}
        # Opt-in ":443" variant for apps that emit the default HTTPS port in their
        # redirect_uri; Keycloak does strict port matching.
        {{- if index $client "includePort443Variant" | default false }}
        {{- $port443Uris := list }}
        {{- range $redirectUris }}
        {{- $port443Uris = append $port443Uris (. | replace (printf "https://%s/" $host) (printf "https://%s:443/" $host)) }}
        {{- end }}
        {{- $redirectUris = concat $redirectUris $port443Uris }}
        {{- end }}
        {{- $rawValues := index $client "rawValues" | default dict }}
        {{- $isPublicClient := false }}
        {{- if hasKey $rawValues "publicClient" }}
        {{- $isPublicClient = index $rawValues "publicClient" }}
        {{- end }}
        {{- $clientDefaults := dict
          "clientId" $clientId
          "name" ($client.name | default $clientId)
          "description" (index $client "description" | default "")
          "enabled" true
          "protocol" "openid-connect"
          "publicClient" false
          "rootUrl" (printf "https://%s" $host)
          "baseUrl" (printf "https://%s" $host)
          "bearerOnly" false
          "standardFlowEnabled" true
          "implicitFlowEnabled" false
          "directAccessGrantsEnabled" true
          "serviceAccountsEnabled" false
          "authorizationServicesEnabled" false
          "webOrigins" (list (printf "https://%s" $host))
          "defaultClientScopes" (list "basic" "email" "profile" "roles" "web-origins")
          "optionalClientScopes" (list "address" "phone" "microprofile-jwt")
        }}
        {{- /* Redirect URIs and PKCE belong to every browser client. A public client has
               no secret to fall back on, so leaving them out of that branch left it
               unable to complete a login at all. Only the secret is confidential-only. */}}
        {{- $_ := set $clientDefaults "redirectUris" $redirectUris }}
        {{- $_ := set $clientDefaults "attributes" (dict "post.logout.redirect.uris" "+" "pkce.code.challenge.method" "S256") }}
        {{- /* T-5568, TR-03187 AR-6: a session Keycloak ends (an administrator's logout or
               disable, the person's own sign-out, an expiry) is posted to the Portal, which
               refuses the person's tokens on the Portal and, through its revocation list, on
               the gateway. Over the in-cluster Service: Keycloak's egress has no route to the
               public host. */}}
        {{- if and (index $client "backchannelLogout") (has "portal" $.Values.components) }}
        {{- $portalNamespace := required (printf "%s: no namespace for portal.portal" $clientId) (index $.Values "portal" "portal" "namespace") }}
        {{- $_ := set $clientDefaults.attributes "backchannel.logout.url" (printf "http://portal.%s.svc.cluster.local:8080/api/v1/auth/backchannel-logout" $portalNamespace) }}
        {{- $_ := set $clientDefaults.attributes "backchannel.logout.session.required" "true" }}
        {{- end }}
        {{- $federated := index $client "federated" }}
        {{- if and (not $isPublicClient) (not $federated) }}
        {{- $_ := set $clientDefaults "secret" (printf "$(CLIENT_SECRET_%s)" ($clientId | upper | replace "-" "_")) }}
        {{- end }}
        {{- $finalClient := mergeOverwrite $clientDefaults ($rawValues | default dict) }}
        {{- /* PF-47, T-2868: a platform workload's client trusts its pod's projected
               ServiceAccount token, verified against the `kubernetes` provider below, and holds
               no secret. Set after the merge, so a client's own attributes cannot drop it. */}}
        {{- if $federated }}
        {{- $release := splitList "." (required (printf "%s: federated.release" $clientId) $federated.release) }}
        {{- $namespace := required (printf "%s: no namespace for %s" $clientId $federated.release) (index $.Values (index $release 0) (index $release 1) "namespace") }}
        {{- $_ := set $finalClient "clientAuthenticatorType" "federated-jwt" }}
        {{- $_ := set $finalClient.attributes "jwt.credential.issuer" "kubernetes" }}
        {{- $_ := set $finalClient.attributes "jwt.credential.sub" (printf "system:serviceaccount:%s:%s" $namespace (required (printf "%s: federated.serviceAccount" $clientId) $federated.serviceAccount)) }}
        {{- end }}
        {{- /* Who the caller is, on every client the platform trusts: a `RoleBinding` names a
               group and the Portal checks the binding (PF-50, PF-61), and the forge maps the
               same claim onto its teams (PF-79). Identity, never permission. A client's own
               mappers are added to this one, because `mergeOverwrite` would otherwise drop
               the list the client did not repeat. Full paths (ADR-N-067 2.2): every reader
               trims the one leading slash, so a root group reads as its name and a subgroup as
               `{org}/{group}`, which no project, Group or grant name can equal (a `/` is no
               DNS-1123 character); a bare subgroup name would match another Organization's
               `members`. The forge's team map names `/{group}`. */}}
        {{- $groupsMapper := dict
          "name" "groups"
          "protocol" "openid-connect"
          "protocolMapper" "oidc-group-membership-mapper"
          "consentRequired" false
          "config" (dict
            "claim.name" "groups"
            "full.path" "true"
            "access.token.claim" "true"
            "id.token.claim" "true"
            "userinfo.token.claim" "true")
        }}
        {{- /* How the caller signed in (T-5567): `amr` lists the reference of every step the
               login ran, `otp` for each one-time-code step ("otp reference …" configs), so the Portal
               sees a second factor whichever subflow asked it. */}}
        {{- $amrMapper := dict
          "name" "amr"
          "protocol" "openid-connect"
          "protocolMapper" "oidc-amr-mapper"
          "consentRequired" false
          "config" (dict
            "access.token.claim" "true"
            "id.token.claim" "true"
            "introspection.token.claim" "true")
        }}
        {{- /* The person's Organizations and their groups in them (ADR-N-067 2.2, 2.7):
               `jc_org` and `jc_groups` are attributes of each `/{org}/{group}` group, never of a
               person. `aggregate.attrs` reads the person's own attribute of that name first,
               which the realm's user profile refuses to hold (no unmanaged attributes:
               `unmanagedAttributePolicy` stays unset, tests/test_keycloak_org_claims.py), so
               only group membership feeds them. */}}
        {{- $orgMappers := list }}
        {{- range $claim := list "jc_org" "jc_groups" }}
        {{- $orgMappers = append $orgMappers (dict
          "name" $claim
          "protocol" "openid-connect"
          "protocolMapper" "oidc-usermodel-attribute-mapper"
          "consentRequired" false
          "config" (dict
            "user.attribute" $claim
            "claim.name" $claim
            "jsonType.label" "String"
            "multivalued" "true"
            "aggregate.attrs" "true"
            "access.token.claim" "true"
            "id.token.claim" "true"
            "userinfo.token.claim" "true")) }}
        {{- end }}
        {{- $_ := set $finalClient "protocolMappers" (concat (list $groupsMapper $amrMapper) $orgMappers (index $rawValues "protocolMappers" | default list)) }}
        {{- /* The gateway alone exchanges a caller's token for the brokers' audiences
               (ADR-N-047 §2.4, T-3999): standard token exchange V2 on its client, and the
               broker scopes above optional on it, so its own client_credentials token names no
               broker. A person's token is a subject token here because the edge adds the
               `context-gateway` audience (components/apisix/keycloak-clients.yaml). */}}
        {{- if and (eq $clientId "context-gateway") (has "context-broker" $.Values.components) }}
        {{- $_ := set $finalClient.attributes "standard.token.exchange.enabled" "true" }}
        {{- $brokerScopes := list "context-broker-main" }}
        {{- range $b := $global.contextBrokers | default list }}
        {{- $brokerScopes = append $brokerScopes (printf "context-broker-%s" $b.name) }}
        {{- end }}
        {{- $_ := set $finalClient "optionalClientScopes" (concat $finalClient.optionalClientScopes $brokerScopes) }}
        {{- end }}
        - {{ $finalClient | toYaml | nindent 10 }}
        {{- end }}
      # The forge reads group membership from the `groups` claim and maps it onto its teams
      # (docs Architecture/12 §2, PF-79). `platform-readers` is the forge mirror of the
      # `viewer` binding every signed-in person of the organization carries (PF-61): it
      # grants nothing in the platform, where permission comes from the RoleBindings in the
      # configuration repository, and only lands the person in the forge team that reads.
      # The reconciler never touches it: it manages only the groups it marks itself (PF-63).
      groups:
        - name: platform-readers
          path: /platform-readers
        {{- /* Every group a demo user is put in, so the realm holds the one the user names:
               keycloak-config-cli fails the whole import on a membership of a group that does
               not exist, and the demo would come up with no realm at all. A project's group is
               what makes a person one of that project's own to the gateway, which resolves a
               human's project out of this claim before it reads a Policy
               (context-gateway app.rs, EP-14/EP-15, T-2456). */}}
        {{- $declared := dict }}
        {{- range $name, $user := $this.demoUsers | default dict }}
        {{- range (index $user "groups" | default list) }}
        {{- $_ := set $declared . true }}
        {{- end }}
        {{- end }}
        {{- /* And the owner's of a production realm (T-4678). */}}
        {{- range (index ($this.initialUser | default dict) "groups" | default list) }}
        {{- $_ := set $declared . true }}
        {{- end }}
        {{- /* And each Organization's subtree root, made here by keycloak-config-cli alone and
               never by hand (ADR-N-058 2.5, T-5242). */}}
        {{- range ($this.organizations | default list) }}
        {{- $_ := set $declared . true }}
        {{- end }}
        {{- /* The groups inside an Organization (ADR-N-067 2.2, 2.7), each carrying the
               Organization's name and its own path as the attributes `jc_org` and `jc_groups`
               the tokens read. A person names one as `{org}/{group}`, declared here only. */}}
        {{- $orgGroups := $this.organizationGroups | default dict }}
        {{- range $org, $_ := $orgGroups }}
        {{- $_ := set $declared $org true }}
        {{- end }}
        {{- range $group, $_ := $declared }}
        {{- if not (contains "/" $group) }}
        - name: {{ $group }}
          path: /{{ $group }}
          {{- with index $orgGroups $group }}
          subGroups:
            {{- range $sub := . }}
            - name: {{ $sub }}
              path: /{{ $group }}/{{ $sub }}
              attributes:
                jc_org: [{{ $group | quote }}]
                jc_groups: [{{ printf "/%s/%s" $group $sub | quote }}]
            {{- end }}
          {{- end }}
        {{- end }}
        {{- end }}
      defaultGroups:
        - /platform-readers
      # The trust a workload's federated client rests on (PF-47): Keycloak verifies a pod's
      # projected ServiceAccount token against this issuer's keys. The Portal's reconciler names
      # the alias in every such client and never writes it here.
      identityProviders:
        - alias: kubernetes
          providerId: kubernetes
          enabled: true
          config:
            # k3s's own service-account issuer (`--service-account-issuer` left at its default).
            issuer: "https://kubernetes.default.svc.cluster.local"
      roles:
        realm:
          # Checked by the Portal (src/api/changes.rs) before a user may approve a change
          # proposal; a user without it can browse and propose only.
          - name: portal-approver
            description: May approve and merge change proposals in the Portal
            {{- /* dev alone sets global.approverMfa false (T-5776, owner 2026-10-26): its demo
                   approvers sign in with a password; anything but `false` keeps T-5120. */}}
            {{- if ne (toString $global.approverMfa) "false" }}
            composite: true
            composites:
              realm: [mfa-required]
            {{- else }}
            composite: false
            {{- end }}
          # Administers the operator UIs: Argo CD's role:admin (components/gitops, ADR-N-056
          # §2.8) and Grafana's Admin. The owner grants it; nobody holds it by default.
          - name: platform-admin
            description: Administers the operator UIs (Argo CD, Grafana)
            composite: true
            composites:
              realm: [mfa-required]
          # Signs in with TOTP (T-5120): the browser flow's role condition reads it, and every
          # role that approves or administers carries it as a composite. Granted on its own it
          # puts any other person under the same rule.
          - name: mfa-required
            description: Must sign in with a second factor (TOTP)
        client:
          {{- range $clientId, $client := .Values.keycloakClients }}
          {{- if index $client "roles" }}
          {{ $clientId }}:
            {{- index $client "roles" | toYaml | nindent 12 }}
          {{- end }}
          {{- end }}
      # TR-03187 AUT-2: Custom browser flow (T-5120). A person holding `mfa-required` (every
      # portal-approver and platform-admin) must give a TOTP code; one without a TOTP credential
      # enrols at the next login (Keycloak's CONFIGURE_TOTP required action). Everyone else is
      # asked for TOTP or WebAuthn only once they configured one. The two subflows exclude each
      # other by the same role, so nobody is asked twice.
      # CONFIGURE_TOTP is the enrolment every REQUIRED one-time-code step falls back to; declared
      # so the render proves it is on (T-5567).
      requiredActions:
        - alias: CONFIGURE_TOTP
          name: Configure OTP
          providerId: CONFIGURE_TOTP
          enabled: true
          defaultAction: false
          priority: 10
      authenticatorConfig:
        # Every one-time-code step tags the session with `otp`; the `oidc-amr-mapper` of each
        # client writes it into `amr`, which the Portal reads before every decision (T-5567).
        # One alias per step: keycloak-config-cli binds a config to one execution, and a step
        # without its own carries no reference (Keycloak 26.8, measured on a throwaway realm).
        - alias: "otp reference required"
          config:
            default.reference.value: otp
        - alias: "otp reference step-up"
          config:
            default.reference.value: otp
        - alias: "otp reference grant required"
          config:
            default.reference.value: otp
        - alias: "otp reference grant"
          config:
            default.reference.value: otp
        - alias: "otp reference optional"
          config:
            default.reference.value: otp
        # The password, level 1, holds for the SSO session's whole lifespan (ssoSessionMaxLifespan).
        - alias: "password level"
          config:
            loa-condition-level: "1"
            loa-max-age: "36000"
        # The step-up a decision asks for (T-5567): level 2, met for five minutes after the code.
        - alias: "step-up level"
          config:
            loa-condition-level: "2"
            loa-max-age: "300"
        - alias: "mfa required"
          config:
            condUserRole: mfa-required
            negate: "false"
        - alias: "mfa not required"
          config:
            condUserRole: mfa-required
            negate: "true"
      authenticationFlows:
        - alias: "custom browser"
          description: "Custom browser flow with conditional 2FA per TR-03187"
          providerId: "basic-flow"
          topLevel: true
          builtIn: false
          authenticationExecutions:
            - authenticator: "auth-cookie"
              authenticatorFlow: false
              requirement: "ALTERNATIVE"
              priority: 10
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticator: "identity-provider-redirector"
              authenticatorFlow: false
              requirement: "ALTERNATIVE"
              priority: 20
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticatorFlow: true
              requirement: "ALTERNATIVE"
              priority: 30
              flowAlias: "custom browser forms"
              userSetupAllowed: false
              autheticatorFlow: true
        - alias: "custom browser forms"
          description: "Username/password, then the second factor the person's role or credentials ask for"
          providerId: "basic-flow"
          topLevel: false
          builtIn: false
          authenticationExecutions:
            # Level 1 is the password: Keycloak's level conditions run every level when nothing
            # is requested and none is reached yet, so the password must be a level of its own
            # for the step-up subflow (level 2) to run only when a login asks for it (T-5567).
            - authenticatorFlow: true
              requirement: "CONDITIONAL"
              priority: 10
              flowAlias: "custom browser password"
              userSetupAllowed: false
              autheticatorFlow: true
            - authenticatorFlow: true
              requirement: "CONDITIONAL"
              priority: 20
              flowAlias: "custom browser required 2fa"
              userSetupAllowed: false
              autheticatorFlow: true
            - authenticatorFlow: true
              requirement: "CONDITIONAL"
              priority: 30
              flowAlias: "custom browser 2fa"
              userSetupAllowed: false
              autheticatorFlow: true
            - authenticatorFlow: true
              requirement: "CONDITIONAL"
              priority: 40
              flowAlias: "custom browser step-up"
              userSetupAllowed: false
              autheticatorFlow: true
        - alias: "custom browser required 2fa"
          description: "TOTP for every holder of mfa-required; enrolment at the next login"
          providerId: "basic-flow"
          topLevel: false
          builtIn: false
          authenticationExecutions:
            - authenticator: "conditional-user-role"
              authenticatorFlow: false
              authenticatorConfig: "mfa required"
              requirement: "REQUIRED"
              priority: 10
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticator: "auth-otp-form"
              authenticatorFlow: false
              authenticatorConfig: "otp reference required"
              requirement: "REQUIRED"
              priority: 20
              userSetupAllowed: false
              autheticatorFlow: false
        - alias: "custom browser password"
          description: "Level 1: username and password (T-5567)"
          providerId: "basic-flow"
          topLevel: false
          builtIn: false
          authenticationExecutions:
            - authenticator: "conditional-level-of-authentication"
              authenticatorFlow: false
              authenticatorConfig: "password level"
              requirement: "REQUIRED"
              priority: 10
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticator: "auth-username-password-form"
              authenticatorFlow: false
              requirement: "REQUIRED"
              priority: 20
              userSetupAllowed: false
              autheticatorFlow: false
        - alias: "custom browser step-up"
          description: "The step-up a decision asks (acr_values=mfa): TOTP of anyone, enrolment if none (T-5567)"
          providerId: "basic-flow"
          topLevel: false
          builtIn: false
          authenticationExecutions:
            - authenticator: "conditional-level-of-authentication"
              authenticatorFlow: false
              authenticatorConfig: "step-up level"
              requirement: "REQUIRED"
              priority: 10
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticator: "auth-otp-form"
              authenticatorFlow: false
              authenticatorConfig: "otp reference step-up"
              requirement: "REQUIRED"
              priority: 20
              userSetupAllowed: false
              autheticatorFlow: false
        - alias: "custom direct grant"
          description: "Password grant: username, password, then TOTP of every mfa-required holder"
          providerId: "basic-flow"
          topLevel: true
          builtIn: false
          authenticationExecutions:
            - authenticator: "direct-grant-validate-username"
              authenticatorFlow: false
              requirement: "REQUIRED"
              priority: 10
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticator: "direct-grant-validate-password"
              authenticatorFlow: false
              requirement: "REQUIRED"
              priority: 20
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticatorFlow: true
              requirement: "CONDITIONAL"
              priority: 30
              flowAlias: "custom direct grant required otp"
              userSetupAllowed: false
              autheticatorFlow: true
            - authenticatorFlow: true
              requirement: "CONDITIONAL"
              priority: 40
              flowAlias: "custom direct grant otp"
              userSetupAllowed: false
              autheticatorFlow: true
        - alias: "custom direct grant required otp"
          description: "TOTP for every holder of mfa-required; one not yet enrolled gets no token"
          providerId: "basic-flow"
          topLevel: false
          builtIn: false
          authenticationExecutions:
            - authenticator: "conditional-user-role"
              authenticatorFlow: false
              authenticatorConfig: "mfa required"
              requirement: "REQUIRED"
              priority: 10
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticator: "direct-grant-validate-otp"
              authenticatorFlow: false
              authenticatorConfig: "otp reference grant required"
              requirement: "REQUIRED"
              priority: 20
              userSetupAllowed: false
              autheticatorFlow: false
        - alias: "custom direct grant otp"
          description: "Optional TOTP: asked of a person without mfa-required who configured one"
          providerId: "basic-flow"
          topLevel: false
          builtIn: false
          authenticationExecutions:
            - authenticator: "conditional-user-role"
              authenticatorFlow: false
              authenticatorConfig: "mfa not required"
              requirement: "REQUIRED"
              priority: 5
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticator: "conditional-user-configured"
              authenticatorFlow: false
              requirement: "REQUIRED"
              priority: 10
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticator: "direct-grant-validate-otp"
              authenticatorFlow: false
              authenticatorConfig: "otp reference grant"
              requirement: "REQUIRED"
              priority: 20
              userSetupAllowed: false
              autheticatorFlow: false
        - alias: "custom browser 2fa"
          description: "Optional 2FA: prompts only a person without mfa-required who configured TOTP or WebAuthn"
          providerId: "basic-flow"
          topLevel: false
          builtIn: false
          authenticationExecutions:
            - authenticator: "conditional-user-role"
              authenticatorFlow: false
              authenticatorConfig: "mfa not required"
              requirement: "REQUIRED"
              priority: 5
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticator: "conditional-user-configured"
              authenticatorFlow: false
              requirement: "REQUIRED"
              priority: 10
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticator: "auth-otp-form"
              authenticatorFlow: false
              authenticatorConfig: "otp reference optional"
              requirement: "ALTERNATIVE"
              priority: 20
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticator: "webauthn-authenticator"
              authenticatorFlow: false
              requirement: "ALTERNATIVE"
              priority: 30
              userSetupAllowed: false
              autheticatorFlow: false
  # TR-03187: Harden master realm — admin accounts are highest-value targets
  master:
    inline:
      realm: master
      # TR-03187 AR-11: Use ES256 for token signatures
      defaultSignatureAlgorithm: ES256
      # TR-03187: 30min idle timeout for admin sessions
      ssoSessionIdleTimeout: 1800
      ssoSessionMaxLifespan: 36000
      rememberMe: false
      # TR-03187: Brute force protection enabled, lockout after 10 attempts
      bruteForceProtected: true
      permanentLockout: false
      maxFailureWaitSeconds: 900
      minimumQuickLoginWaitSeconds: 60
      waitIncrementSeconds: 60
      quickLoginCheckMilliSeconds: 1000
      maxDeltaTimeSeconds: 43200
      failureFactor: 10
      # TR-03187: Stricter password policy for admin accounts — 20 chars, upper, lower, digit, special
      passwordPolicy: "length(20) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)"
      # TR-03187 AR-11: Use SHA256 for OTP
      otpPolicyAlgorithm: HmacSHA256
      # TR-03187 AUT-2 (T-5567): every administrator of the master realm gives a TOTP code at
      # the browser login and enrols at the next one without a credential. The direct grant
      # keycloak-config-cli signs in with is Keycloak's own flow and stays as it is.
      browserFlow: master browser
      requiredActions:
        - alias: CONFIGURE_TOTP
          name: Configure OTP
          providerId: CONFIGURE_TOTP
          enabled: true
          defaultAction: false
          priority: 10
      authenticationFlows:
        - alias: "master browser"
          description: "Browser login of the master realm: password and TOTP"
          providerId: "basic-flow"
          topLevel: true
          builtIn: false
          authenticationExecutions:
            - authenticator: "auth-cookie"
              authenticatorFlow: false
              requirement: "ALTERNATIVE"
              priority: 10
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticatorFlow: true
              requirement: "ALTERNATIVE"
              priority: 20
              flowAlias: "master browser forms"
              userSetupAllowed: false
              autheticatorFlow: true
        - alias: "master browser forms"
          description: "Username/password, then TOTP"
          providerId: "basic-flow"
          topLevel: false
          builtIn: false
          authenticationExecutions:
            - authenticator: "auth-username-password-form"
              authenticatorFlow: false
              requirement: "REQUIRED"
              priority: 10
              userSetupAllowed: false
              autheticatorFlow: false
            - authenticator: "auth-otp-form"
              authenticatorFlow: false
              requirement: "REQUIRED"
              priority: 20
              userSetupAllowed: false
              autheticatorFlow: false
