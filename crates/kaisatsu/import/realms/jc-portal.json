{
  "id": "jc",
  "realm": "jc",
  "displayName": "joinedcontext",
  "enabled": true,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "verifyEmail": true,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and notUsername",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "sk",
    "cs",
    "de",
    "hu"
  ],
  "defaultLocale": "en",
  "defaultRoles": [
    "offline_access"
  ],
  "roles": {
    "realm": [
      {
        "name": "mfa-required",
        "description": "Must sign in with a second factor (TOTP)",
        "composite": false
      },
      {
        "name": "portal-approver",
        "description": "May approve and merge change proposals in the Portal",
        "composite": true,
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      }
    ]
  },
  "groups": [
    {
      "name": "platform-admins",
      "path": "/platform-admins"
    }
  ],
  "defaultOptionalClientScopes": [
    "connector",
    "offline_access"
  ],
  "clientProfiles": {
    "profiles": [
      {
        "name": "cimd",
        "description": "Client ID Metadata Documents of the known AI clients",
        "executors": [
          {
            "executor": "client-id-metadata-document",
            "configuration": {
              "accept-public-client-with-confidential-client-only-grant": true,
              "cimd-allow-permitted-domains": [
                "claude.ai",
                "vscode.dev",
                "code.visualstudio.com",
                "localhost",
                "127.0.0.1"
              ]
            }
          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "cimd",
        "description": "Client ids that are https URLs of the known AI clients",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-id-uri",
            "configuration": {
              "client-id-uri-allow-permitted-domains": [
                "claude.ai",
                "vscode.dev"
              ],
              "client-id-uri-scheme": [
                "https"
              ]
            }
          }
        ],
        "profiles": [
          "cimd"
        ]
      }
    ]
  },
  "clientScopes": [
    {
      "name": "connector",
      "description": "One AI connector you created in the Portal",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "is.parameterized.scope": "true",
        "parameterized.scope.type": "custom",
        "parameterized.scope.regexp": "[a-z2-7]{26}",
        "consent.screen.text": "Use one AI connector you created in the Portal, with the rights you gave it"
      },
      "protocolMappers": [
        {
          "name": "portal-connectors-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "portal-connectors"
          }
        },
        {
          "name": "portal-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.client.audience": "portal-api"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "jc_org",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "jc_org",
            "claim.name": "jc_org",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "jc_groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "jc_groups",
            "claim.name": "jc_groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "mcp:portal",
      "description": "Audience of the Portal MCP server at /api/v1/mcp",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "portal-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.client.audience": "portal-api"
          }
        }
      ]
    },
    {
      "name": "gateway-hub",
      "description": "Audience of the MCP hub in the Portal's exchanged token for one Endpoint",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "mcp-hub-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.client.audience": "mcp-hub"
          }
        }
      ]
    }
  ],
