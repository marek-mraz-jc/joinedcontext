{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KaisatsuRealmFile",
  "description": "JSON Schema of the keycloak-config-cli RealmRepresentation accepted by kaisatsu apply (W1b).",
  "type": "object",
  "required": ["realm"],
  "properties": {
    "id": { "type": "string" },
    "realm": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string" },
    "enabled": { "type": "boolean" },
    "defaultSignatureAlgorithm": { "type": "string", "enum": ["ES256", "RS256", "EdDSA"] },
    "revokeRefreshToken": { "type": "boolean" },
    "refreshTokenMaxReuse": { "type": "integer", "minimum": 0 },
    "accessTokenLifespan": { "type": "integer", "minimum": 1 },
    "ssoSessionIdleTimeout": { "type": "integer", "minimum": 1 },
    "ssoSessionMaxLifespan": { "type": "integer", "minimum": 1 },
    "offlineSessionIdleTimeout": { "type": "integer", "minimum": 1 },
    "offlineSessionMaxLifespanEnabled": { "type": "boolean" },
    "offlineSessionMaxLifespan": { "type": "integer", "minimum": 1 },
    "accessCodeLifespan": { "type": "integer", "minimum": 1 },
    "bruteForceProtected": { "type": "boolean" },
    "permanentLockout": { "type": "boolean" },
    "maxFailureWaitSeconds": { "type": "integer" },
    "minimumQuickLoginWaitSeconds": { "type": "integer" },
    "waitIncrementSeconds": { "type": "integer" },
    "quickLoginCheckMilliSeconds": { "type": "integer" },
    "maxDeltaTimeSeconds": { "type": "integer" },
    "failureFactor": { "type": "integer" },
    "passwordPolicy": { "type": "string" },
    "otpPolicyType": { "type": "string" },
    "otpPolicyAlgorithm": { "type": "string" },
    "otpPolicyDigits": { "type": "integer" },
    "otpPolicyLookAheadWindow": { "type": "integer" },
    "otpPolicyPeriod": { "type": "integer" },
    "defaultOptionalClientScopes": { "type": "array", "items": { "type": "string" } },
    "defaultGroups": { "type": "array", "items": { "type": "string" } },
    "clientScopes": { "type": "array" },
    "clients": { "type": "array" },
    "users": { "type": "array" },
    "groups": { "type": "array" },
    "roles": { "type": "object" },
    "identityProviders": { "type": "array" },
    "requiredActions": { "type": "array" },
    "authenticationFlows": { "type": "array" }
  }
}
