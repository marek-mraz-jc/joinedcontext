@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix hydra: <http://www.w3.org/ns/hydra/core#> .
@prefix leg: <https://data.gov.sk/def/ontology/legislation/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pu: <https://data.gov.cz/slovník/podmínky-užití/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.europa.eu/eli/reg_impl/2023/138/oj> a eli:LegalResource .

<http://data.europa.eu/nuts/code/SK032> a dct:Location .

<http://publications.europa.eu/resource/authority/data-theme/ENVI> a skos:Concept ;
  skos:prefLabel "Environment"@en .

<http://publications.europa.eu/resource/authority/file-type/CSV> a dct:MediaTypeOrExtent .

<http://publications.europa.eu/resource/authority/frequency/DAILY> a dct:Frequency .

<http://www.iana.org/assignments/media-types/text/csv> a dct:MediaType .

<https://opendata.example.org/dataset/air> a dcat:Dataset ;
  dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
  dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/DAILY> ;
  dct:description "Measurements"@en, "Merania"@sk, "Měření"@cs ;
  dct:publisher <https://publisher.example.org/id/city> ;
  dct:spatial <http://data.europa.eu/nuts/code/SK032> ;
  dct:title "Air quality"@en, "Kvalita ovzdušia"@sk, "Kvalita ovzduší"@cs ;
  dcat:contactPoint _:b1 ;
  dcat:distribution <https://opendata.example.org/dataset/air/resource/res-1> ;
  dcat:keyword "PM10"@sk, "air"@en, "ovzdušie"@sk, "ovzduší"@cs ;
  dcat:theme <http://publications.europa.eu/resource/authority/data-theme/ENVI> .

<https://opendata.example.org/dataset/air/resource/res-1> a dcat:Distribution ;
  dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
  dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
  dct:title "CSV súbor"@sk ;
  dcat:accessURL <https://files.example.org/air> ;
  dcat:downloadURL <https://files.example.org/air.csv> ;
  dcat:mediaType <http://www.iana.org/assignments/media-types/text/csv> ;
  pu:specifikace _:b2 .

<https://publisher.example.org/id/city> a foaf:Agent ;
  foaf:name "City"@en, "Mesto"@sk, "Město"@cs .

_:b1 a vcard:Kind, vcard:Organization ;
  vcard:fn "Oddelenie"@sk ;
  vcard:hasEmail <mailto:data@city.example> .

_:b2 a pu:Specifikace ;
  pu:autor "Mesto"@sk ;
  pu:autor-databáze "Mesto"@sk ;
  pu:autorské-dílo <https://creativecommons.org/licenses/by/4.0/> ;
  pu:databáze-chráněná-zvláštními-právy <https://creativecommons.org/publicdomain/zero/1.0/> ;
  pu:databáze-jako-autorské-dílo <https://creativecommons.org/licenses/by/4.0/> ;
  pu:osobní-údaje <https://example.org/personal-data/declared> .

