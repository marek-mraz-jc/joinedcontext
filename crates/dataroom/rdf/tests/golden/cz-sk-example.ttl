  dct:conformsTo <https://opendata.middop.sk/schemy/json-schema.json> ;
  dct:format <http://publications.europa.eu/resource/authority/file-type/ZIP> ;
  dct:title "JSON distribution in ZIP file"@en, "JSON distribúcia v ZIP súbore"@sk ;
  dcat:accessURL <https://opendata.middop.sk/pub/draha/mestske/JDF.zip> ;
  dcat:compressFormat <http://www.iana.org/assignments/media-types/application/zip> ;
  dcat:downloadURL <https://opendata.middop.sk/pub/draha/mestske/JDF.zip> ;
  dcat:mediaType <http://www.iana.org/assignments/media-types/application/json> ;
  dcat:packageFormat <http://www.iana.org/assignments/media-types/application/zip> ;
  pu:specifikace _:b3 .

