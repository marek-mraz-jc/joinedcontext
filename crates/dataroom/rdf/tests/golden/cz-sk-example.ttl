<https://data.gov.sk/set/vld> a dcat:Dataset ;
  dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/WEEKLY_3> ;
  dct:conformsTo <https://data.gov.sk/def/ontology/transport/> ;
  dct:description "Obsahom datasetu sú schválené a aktuálne platné cestovné poriadky verejné linkové dopravy poskytnuté do Centrálneho informačního systému Cestovné poriadky ve strojovo spracovateľnom formáte."@sk, "This dataset contains approved timetables and timetables in effect for public transport entered into the state-wide timetable information system."@en ;
  dct:publisher <https://data.gov.sk/legal-subject/30416094> ;
  dct:spatial <https://data.gov.sk/id/nuts1/SK0> ;
  dct:temporal _:b2 ;
  dct:title "Cestovné poriadky"@sk, "Public transport timetables"@en ;
  dcat:contactPoint _:b1 ;
  dcat:distribution <https://data.gov.sk/set/vld/resource/csv>, <https://data.gov.sk/set/vld/resource/sparql> ;
  dcat:keyword "autobusy"@sk, "bus"@en, "cestovné poriadky"@sk, "public transport"@en, "timetable"@en, "verejná linková doprava"@sk ;
  dcat:landingPage <https://opendata.mindop.sk/show/vld> ;
  dcat:spatialResolutionInMeters "12.0"^^xsd:decimal ;
  dcat:temporalResolution "P1D"^^xsd:duration ;
  dcat:theme <http://eurovoc.europa.eu/4512>, <http://publications.europa.eu/resource/authority/data-theme/TRAN> .

