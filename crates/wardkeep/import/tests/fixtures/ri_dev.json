  "defaultGroups": ["/platform-readers"],
  "identityProviders": [
    {
      "alias": "kubernetes",
      "providerId": "kubernetes",
      "enabled": true,
      "config": {
        "issuer": "https://kubernetes.default.svc.cluster.local"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "mfa-required",
        "description": "Must sign in with a second factor (TOTP)",
        "composite": false
      },
      {
        "name": "portal-approver",
        "description": "May approve and merge change proposals in the Portal",
        "composite": true,
        "composites": {
          "realm": ["mfa-required"]
        }
      },
      {
        "name": "platform-admin",
        "description": "Administers the operator UIs (Argo CD, Grafana)",
        "composite": true,
        "composites": {
          "realm": ["mfa-required"]
        }
      }
    ]
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    }
  ],
  "authenticatorConfig": [
    { "alias": "otp reference required", "config": { "default.reference.value": "otp" } },
    { "alias": "otp reference step-up", "config": { "default.reference.value": "otp" } },
    { "alias": "otp reference grant required", "config": { "default.reference.value": "otp" } },
    { "alias": "otp reference grant", "config": { "default.reference.value": "otp" } },
    { "alias": "otp reference optional", "config": { "default.reference.value": "otp" } },
    { "alias": "password level", "config": { "loa-condition-level": "1", "loa-max-age": "36000" } },
    { "alias": "step-up level", "config": { "loa-condition-level": "2", "loa-max-age": "300" } },
    { "alias": "mfa required", "config": { "condUserRole": "mfa-required", "negate": "false" } },
    { "alias": "mfa not required", "config": { "condUserRole": "mfa-required", "negate": "true" } }
  ],
  "authenticationFlows": [
    {
      "alias": "custom browser",
      "providerId": "basic-flow",
      "topLevel": true,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10 },
        { "authenticator": "identity-provider-redirector", "requirement": "ALTERNATIVE", "priority": 20 },
        { "authenticatorFlow": true, "requirement": "ALTERNATIVE", "priority": 30, "flowAlias": "custom browser forms" }
      ]
    },
    {
      "alias": "custom browser required 2fa",
      "providerId": "basic-flow",
      "topLevel": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-role", "authenticatorConfig": "mfa required", "requirement": "REQUIRED", "priority": 10 },
        { "authenticator": "auth-otp-form", "authenticatorConfig": "otp reference required", "requirement": "REQUIRED", "priority": 20 }
      ]
    },
    {
      "alias": "custom direct grant",
      "providerId": "basic-flow",
      "topLevel": true,
      "authenticationExecutions": [
        { "authenticator": "direct-grant-validate-username", "requirement": "REQUIRED", "priority": 10 },
        { "authenticator": "direct-grant-validate-password", "requirement": "REQUIRED", "priority": 20 }
      ]
    }
  ],
