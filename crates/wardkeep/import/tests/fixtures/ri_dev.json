    { "name": "praha", "path": "/praha" },
    { "name": "slovensko", "path": "/slovensko" },
    { "name": "zilina", "path": "/zilina" },
    { "name": "barcelona", "path": "/barcelona" },
    { "name": "bratislava", "path": "/bratislava" },
    { "name": "sharing-other", "path": "/sharing-other" },
    { "name": "sharing", "path": "/sharing" }
