#!/usr/bin/env python3
"""Smoke suites of a running jc: `run <suite> --base-url <url> --out <dir> [suite options]`.

Each suite is bins/jc/smoke/<suite>/suite.py with a `main(argv)` that writes results.json (one row
per check: id, target, call, expected, actual, result pass/fail/skip, reason) and REPORT.md into
--out, and exits 1 when a check failed."""
import importlib.util
import sys
from pathlib import Path

here = Path(__file__).resolve().parent
suites = sorted(p.parent.name for p in here.glob("*/suite.py"))
if len(sys.argv) < 2 or sys.argv[1] not in suites:
    raise SystemExit(f"usage: run <suite> --base-url <url> --out <dir> ...; suites: {', '.join(suites)}")
spec = importlib.util.spec_from_file_location(f"smoke_{sys.argv[1]}", here / sys.argv[1] / "suite.py")
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
sys.exit(mod.main(sys.argv[2:]))
